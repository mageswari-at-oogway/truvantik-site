---
interface Props { title?: string; sub?: string }
const {
  title = "Let's find your true advantage.",
  sub = "A 30-minute call is usually enough to tell whether there is a real opportunity here, and what the first step should be.",
} = Astro.props;
---
<section class="snap ctaband gridbg">
  <div class="aurora" aria-hidden="true"></div>
  <div class="wrap ctaband__in reveal">
    <p class="kicker">Start here</p>
    <h2>{title}</h2>
    <p class="lead">{sub}</p>
    <div class="ctaband__row">
      <a href="/contact" class="btn btn--grad" data-magnetic>Start a conversation <span class="arw">→</span></a>
      <a href="/services" class="btn btn--ghost">See how we work</a>
    </div>
  </div>
</section>

<style>
  .ctaband__in { text-align: center; display: grid; justify-items: center; gap: 1.3rem; max-width: 52ch; margin-inline: auto; }
  .ctaband h2 { margin-top: 0.3rem; }
  .ctaband__row { display: flex; gap: 0.85rem; flex-wrap: wrap; justify-content: center; margin-top: 0.6rem; }
</style>
