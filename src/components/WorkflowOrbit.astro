---
import Logo from "./Logo.astro";
---
<figure class="workflow-orbit" aria-label="Customer requests and documents flow through Truvantik into the team's existing systems.">
  <div class="orbit-scene">
    <svg class="orbit-paths" viewBox="0 0 560 440" aria-hidden="true">
      <ellipse class="orbit-ring" cx="280" cy="205" rx="190" ry="176" />
      <ellipse class="orbit-ring orbit-ring--inner" cx="280" cy="205" rx="146" ry="134" />
      <g class="orbit-tracks">
        <path d="M138 132 H180 Q205 132 230 170 L258 202"/>
        <path d="M138 260 H180 Q205 260 230 232 L258 212"/>
        <path d="M302 202 L332 156 Q349 128 377 128 H417"/>
        <path d="M302 207 H417"/>
        <path d="M302 212 L332 261 Q349 289 377 289 H417"/>
      </g>
      <g class="orbit-packets">
        <path class="packet packet--input" pathLength="100" d="M138 132 H180 Q205 132 230 170 L258 202"/>
        <path class="packet packet--input packet--second" pathLength="100" d="M138 260 H180 Q205 260 230 232 L258 212"/>
        <path class="packet packet--output" pathLength="100" d="M302 202 L332 156 Q349 128 377 128 H417"/>
        <path class="packet packet--output" pathLength="100" d="M302 207 H417"/>
        <path class="packet packet--output" pathLength="100" d="M302 212 L332 261 Q349 289 377 289 H417"/>
      </g>
    </svg>
    <div class="orbit-label orbit-label--request"><strong>Customer request</strong><span>The work to be done</span></div>
    <div class="orbit-label orbit-label--data"><strong>Documents + data</strong><span>The context behind it</span></div>
    <div class="orbit-core" aria-hidden="true"><Logo withWordmark={false} size={62} /></div>
    <div class="orbit-system orbit-system--crm">CRM</div>
    <div class="orbit-system orbit-system--ops">Operations</div>
    <div class="orbit-system orbit-system--knowledge">Knowledge base</div>
    <span class="orbit-systems-label">Your existing systems</span>
  </div>
  <figcaption>
    <strong>A workflow the team can use.</strong>
    <p>Clearer review, decisions and next actions,<br />inside the tools already in use.</p>
  </figcaption>
</figure>
<style>
  .workflow-orbit { width: 116%; margin-left: -7%; position: relative; }
  .orbit-scene { position: relative; aspect-ratio: 560 / 440; }
  .orbit-paths { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .orbit-ring { fill: none; stroke: var(--border); stroke-width: 1; opacity: .65; }
  .orbit-ring--inner { stroke-dasharray: 2 8; opacity: .5; }
  .orbit-tracks { fill: none; stroke: var(--border-strong); stroke-width: 1; opacity: .6; }
  .packet { fill: none; stroke: var(--accent); stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 10 120; stroke-dashoffset: 10; opacity: 0; }
  .packet--input { animation: input-flow 7.2s linear infinite; }
  .packet--second { animation-delay: .55s; }
  .packet--output { stroke: var(--highlight); animation: output-flow 7.2s linear infinite; }
  .orbit-core { position: absolute; left: 50%; top: 47%; transform: translate(-50%, -50%); width: 84px; height: 84px; display: grid; place-items: center; background: var(--bg); border: 1px solid var(--border); border-radius: 24px; }
  .orbit-core::after { content: ""; position: absolute; inset: -6px; border: 1px solid var(--accent); border-radius: 30px; opacity: 0; animation: core-receive 7.2s ease-in-out infinite; }
  .orbit-label { position: absolute; left: 0; width: 30%; display: grid; gap: .3rem; background: var(--bg); padding-block: .5rem; }
  .orbit-label--request { top: 23%; }
  .orbit-label--data { top: 53%; }
  .orbit-label strong { font-size: clamp(.82rem, 1.25vw, 1rem); font-weight: 500; line-height: 1.25; }
  .orbit-label span { font-size: .75rem; color: var(--ink-3); line-height: 1.35; }
  .orbit-system { position: absolute; left: 74%; width: 26%; padding: .45rem 0 .45rem .65rem; background: var(--bg); color: var(--ink-2); font-size: clamp(.78rem, 1.2vw, .95rem); border-left: 1px solid var(--border-strong); }
  .orbit-system--crm { top: 25%; }
  .orbit-system--ops { top: 43%; }
  .orbit-system--knowledge { top: 62%; }
  .orbit-systems-label { position: absolute; left: 72%; top: 14%; font-size: .7rem; color: var(--ink-3); }
  figcaption { text-align: center; margin-top: -.75rem; }
  figcaption strong { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 500; }
  figcaption p { font-size: .85rem; line-height: 1.5; margin-top: .5rem; color: var(--ink-3); }
  @keyframes input-flow {
    0%, 8% { opacity: 0; stroke-dashoffset: 10; }
    12% { opacity: .9; }
    36% { opacity: .9; stroke-dashoffset: -100; }
    40%, 100% { opacity: 0; stroke-dashoffset: -100; }
  }
  @keyframes output-flow {
    0%, 43% { opacity: 0; stroke-dashoffset: 10; }
    47% { opacity: .9; }
    76% { opacity: .9; stroke-dashoffset: -100; }
    82%, 100% { opacity: 0; stroke-dashoffset: -100; }
  }
  @keyframes core-receive {
    0%, 28%, 65%, 100% { opacity: 0; transform: scale(.96); }
    40%, 48% { opacity: .5; transform: scale(1); }
  }
  @media (max-width: 860px) { .workflow-orbit { width: min(100%, 540px); margin: 0 auto; } }
  @media (max-width: 420px) {
    .orbit-core { width: 64px; height: 64px; border-radius: 18px; }
    .orbit-core :global(.logo__mark) { width: 46px; height: 46px; }
    .orbit-core::after { border-radius: 24px; }
    .orbit-label span { font-size: .68rem; }
    .orbit-systems-label { top: 10%; font-size: .65rem; }
    .orbit-label--request { top: 20%; }
    .orbit-label--data { top: 52%; }
    .orbit-system--knowledge { top: 60%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .packet, .orbit-core::after { animation: none; display: none; }
  }
</style>
