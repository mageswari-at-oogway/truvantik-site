---
// Truvantik diamond mark - colours read theme tokens, wordmark uses currentColor.
interface Props { withWordmark?: boolean; size?: number; class?: string }
const { withWordmark = true, size = 34, class: cls = "" } = Astro.props;
---
<span class={`logo ${cls}`}>
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 64 64" role="img" aria-label="Truvantik">
    <defs>
      <clipPath id="tv-clip">
        <rect x="10" y="10" width="44" height="44" rx="9" transform="rotate(45 32 32)"></rect>
      </clipPath>
    </defs>
    <g clip-path="url(#tv-clip)">
      <rect x="0" y="0" width="64" height="64" fill="var(--logo-face)"></rect>
      <path d="M40 0 L64 24 L64 64 L40 64 Z" fill="var(--logo-corner)"></path>
    </g>
    <path d="M32 15 L47 31 H38.5 V51 H25.5 V31 H17 Z" fill="var(--logo-mark)"></path>
    <rect x="10" y="10" width="44" height="44" rx="9" transform="rotate(45 32 32)"
      fill="none" stroke="var(--logo-stroke)" stroke-width="3"></rect>
  </svg>
  {withWordmark && <span class="logo__word">Truvantik</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .logo__mark { flex-shrink: 0; }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.32rem;
    letter-spacing: -0.03em;
    color: currentColor;
  }
</style>
