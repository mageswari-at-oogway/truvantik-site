---
// Truvantik diamond mark - colours read theme tokens, wordmark uses currentColor.
interface Props { withWordmark?: boolean; size?: number; class?: string }
const { withWordmark = true, size = 34, class: cls = "" } = Astro.props;
---
<span class={`logo ${cls}`}>
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 64 64" fill="none" role="img" aria-label="Truvantik">
    <!-- Diamond Bounding Container -->
    <rect x="10" y="10" width="44" height="44" rx="8" transform="rotate(45 32 32)"
      fill="var(--logo-face)" stroke="var(--logo-stroke)" stroke-width="2.5"></rect>
    <!-- 'T' Top Horizon Beam -->
    <path d="M19 21.5 C19 20.4 19.8 19.5 20.8 19.5 H43.2 C44.2 19.5 45 20.4 45 21.5 V26 H19 Z" fill="var(--logo-corner)"></path>
    <!-- 'V' & Upward Vector Ascending Chevron -->
    <path d="M32 23.5 L45.5 37.5 H37.5 L32 31 L26.5 37.5 H18.5 L32 23.5 Z" fill="var(--logo-mark)"></path>
    <!-- Center Base Anchor -->
    <polygon points="32,38 39,47 25,47" fill="var(--logo-anchor)"></polygon>
  </svg>
  {withWordmark && <span class="logo__word">Truvantik</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .logo__mark { flex-shrink: 0; }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.32rem;
    letter-spacing: -0.03em;
    color: currentColor;
  }
</style>
