---
// Signature product moment: the value x effort prioritisation matrix.
// Opportunities are plotted by value (y) and effort (x); the top-left
// "quick wins" zone is where we start. The chosen pick is promoted into
// a slim Assess -> Build -> Deploy status rail beneath.
// Respects reduced-motion (renders the settled state).
interface Props { compact?: boolean; id?: string }
const { compact = false, id = "roadmap" } = Astro.props;

// value (0-100, higher = better) · effort (0-100, higher = harder)
const ops = [
  { id: "01", t: "Customer support triage", v: 92, e: 36, pick: true },
  { id: "02", t: "Contract & document review", v: 83, e: 57 },
  { id: "03", t: "Returns exception handling", v: 75, e: 46 },
  { id: "04", t: "Onboarding data entry", v: 64, e: 31 },
  { id: "05", t: "Internal knowledge retrieval", v: 54, e: 63 },
  { id: "06", t: "Invoice matching", v: 70, e: 74 },
  { id: "07", t: "Lead enrichment", v: 45, e: 42 },
];
---
<div class:list={["mx", { "mx--compact": compact }]} id={id} data-mx>
  <div class="mx__bar" aria-hidden="true">
    <span class="mx__dots"><i></i><i></i><i></i></span>
    <span class="mx__legend"><b>quick wins</b></span>
    <span class="mx__tag">Illustrative · one client</span>
  </div>

  <div class="mx__plot">
    <span class="mx__yaxis">Value →</span>
    <div class="mx__area" data-area>
      <span class="mx__grid" aria-hidden="true"></span>
      <span class="mx__zone" aria-hidden="true"><em>Quick wins</em></span>
      {ops.map((o, i) => (
        <span
          class:list={["node", { "node--pick": o.pick }]}
          style={`left:${o.e}%; bottom:${o.v}%; --d:${i * 90}ms`}
          data-node
          title={`${o.t} · value ${o.v} / effort ${o.e}`}
        >
          <b class="node__dot"></b>
          {o.pick && <span class="node__label">{o.t}<em>→ promoted to Build</em></span>}
        </span>
      ))}
    </div>
    <span class="mx__xaxis">Effort →</span>
  </div>

  <!-- Assess -> Build -> Deploy status rail -->
  <div class="mx__rail" data-rail>
    <div class="rl rl--assess">
      <span class="rl__k">Assess</span>
      <span class="rl__v" data-count>5 queued</span>
    </div>
    <span class="rl__arrow" aria-hidden="true">→</span>
    <div class="rl rl--build">
      <span class="rl__k">Build</span>
      <span class="rl__v">Support triage copilot</span>
      <span class="rl__bar" aria-hidden="true"><i data-bar></i></span>
      <span class="rl__pct" data-pct>72% · sprint 4/8</span>
    </div>
    <span class="rl__arrow" aria-hidden="true">→</span>
    <div class="rl rl--deploy">
      <span class="rl__k rl__k--live">● Live</span>
      <span class="rl__v">Document review agent</span>
      <span class="rl__meta">In production</span>
    </div>
  </div>
</div>

<style>
  .mx {
    background: var(--surface-solid);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    padding: 1rem 1.1rem 0.9rem;
    position: relative; overflow: hidden;
  }
  [data-theme="bauhaus"] .mx, [data-theme="terminal"] .mx { border-width: 2px; }
  .mx::before { content: ""; position: absolute; inset: 0; background: var(--grad-soft); opacity: 0.4; pointer-events: none; }
  .mx > * { position: relative; }

  .mx__bar { display: flex; align-items: center; gap: 0.7rem; padding-bottom: 0.9rem; }
  .mx__dots { display: inline-flex; gap: 0.35rem; }
  .mx__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--border-strong); }
  [data-theme="bauhaus"] .mx__dots i, [data-theme="terminal"] .mx__dots i { border-radius: 0; }
  .mx__legend b { display: inline-flex; align-items: center; gap: 0.4em; font-family: var(--font-mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); font-weight: 400; }
  .mx__legend b::before { content: ""; width: 12px; height: 12px; border-radius: 3px; background: var(--grad-soft); border: 1px dashed var(--accent); }
  .mx__tag { margin-left: auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }

  /* ---- plot ---- */
  .mx__plot { display: grid; grid-template-columns: auto 1fr; grid-template-rows: 1fr auto; gap: 0.4rem; }
  .mx__yaxis { grid-row: 1; grid-column: 1; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); align-self: center; }
  .mx__xaxis { grid-row: 2; grid-column: 2; text-align: center; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); padding-top: 0.2rem; }
  .mx__area {
    grid-row: 1; grid-column: 2; position: relative;
    aspect-ratio: 1.7 / 1; min-height: 220px;
    border-left: 1.5px solid var(--border-strong);
    border-bottom: 1.5px solid var(--border-strong);
  }
  .mx__grid { position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 25% 25%; opacity: 0.6; }
  .mx__zone { position: absolute; left: 0; top: 0; width: 50%; height: 55%;
    background: var(--grad-soft); border-right: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent); }
  .mx__zone em { position: absolute; left: 10px; top: 8px; font-family: var(--font-mono); font-size: 0.6rem; font-style: normal; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }

  .node { position: absolute; transform: translate(-50%, 50%); --d: 0ms; }
  .node__dot { display: block; width: 13px; height: 13px; border-radius: 50%; background: var(--ink-3);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ink-3) 14%, transparent);
    opacity: 0; transform: scale(0.4); transition: opacity 0.5s var(--ease), transform 0.5s var(--ease-spring); transition-delay: var(--d); }
  [data-theme="bauhaus"] .node__dot, [data-theme="terminal"] .node__dot { border-radius: 0; }
  .mx.in .node__dot { opacity: 1; transform: scale(1); }
  .node--pick .node__dot { width: 17px; height: 17px; background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent); }
  .mx.in .node--pick .node__dot { animation: bob 2.6s var(--ease-in-out) infinite 1s; }
  @keyframes bob { 0%,100% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent); } 50% { box-shadow: 0 0 0 10px color-mix(in srgb, var(--accent) 8%, transparent); } }
  .node__label { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); white-space: nowrap;
    font-family: var(--font-display); font-weight: 600; font-size: 0.76rem; color: var(--ink); line-height: 1.2;
    opacity: 0; transition: opacity 0.5s var(--ease) 0.6s; }
  .mx.in .node__label { opacity: 1; }
  .node__label em { display: block; font-family: var(--font-mono); font-weight: 400; font-size: 0.58rem; font-style: normal; color: var(--accent); }

  /* ---- status rail ---- */
  .mx__rail { display: grid; grid-template-columns: 1fr auto 1.4fr auto 1.4fr; align-items: stretch; gap: 0.5rem;
    margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--border); }
  .rl { background: color-mix(in srgb, var(--bg) 55%, transparent); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.55rem 0.7rem; display: grid; gap: 0.2rem; align-content: center; }
  [data-theme="bauhaus"] .rl, [data-theme="terminal"] .rl { border-width: 1.5px; }
  .rl__k { font-family: var(--font-mono); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); }
  .rl__k--live { color: var(--highlight); }
  .rl__v { font-family: var(--font-display); font-weight: 600; font-size: 0.8rem; line-height: 1.15; }
  .rl__meta, .rl__pct { font-family: var(--font-mono); font-size: 0.58rem; color: var(--ink-3); }
  .rl__bar { display: block; height: 4px; border-radius: 3px; background: var(--surface-3); overflow: hidden; margin-top: 0.15rem; }
  [data-theme="bauhaus"] .rl__bar, [data-theme="terminal"] .rl__bar { border-radius: 0; }
  .rl__bar i { display: block; height: 100%; width: 50%; background: var(--accent); border-radius: 3px; transition: width 1s var(--ease); }
  .rl__arrow { align-self: center; color: var(--ink-3); font-size: 0.9rem; }

  /* compact (hero) */
  .mx--compact .mx__area { min-height: 170px; aspect-ratio: 1.9 / 1; }
  .mx--compact .node__label { font-size: 0.68rem; }
  .mx--compact .rl__arrow { display: none; }
  .mx--compact .mx__rail { grid-template-columns: 1fr 1fr 1fr; }

  /* responsive */
  @media (max-width: 640px) {
    .mx__rail { grid-template-columns: 1fr; }
    .mx__rail .rl__arrow { display: none; }
    .mx__area { min-height: 190px; }
    .node__label { font-size: 0.64rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mx.in .node--pick .node__dot { animation: none; }
  }
</style>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;
    const bar = root.querySelector("[data-bar]");
    const pct = root.querySelector("[data-pct]");
    const count = root.querySelector("[data-count]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const play = () => {
      root.classList.add("in");
      if (reduce) { if (bar) bar.style.width = "72%"; return; }
      // animate the build bar filling to 72% once the nodes are in
      setTimeout(() => {
        if (bar) bar.style.width = "72%";
        if (pct) pct.textContent = "72% · sprint 4/8";
        if (count) count.textContent = "4 queued";
      }, 900);
    };

    if (!("IntersectionObserver" in window)) { play(); return; }
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { play(); io.unobserve(root); } });
    }, { threshold: 0.3 });
    io.observe(root);
  })();
</script>
