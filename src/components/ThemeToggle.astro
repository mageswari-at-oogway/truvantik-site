---
// Theme choice, persisted to localStorage.
---
<div class="tt" id="theme-switcher">
  <button class="tt__trigger" id="theme-toggle" type="button" aria-label="Choose colour theme" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu">
    <span class="tt__current" aria-hidden="true"></span>
  </button>
  <div class="tt__menu" id="theme-menu" role="menu" hidden>
    <button type="button" role="menuitemradio" data-theme-choice="void" aria-checked="true"><span class="tt__swatch tt__swatch--void"></span><span>Void</span><span class="tt__check" aria-hidden="true">✓</span></button>
    <button type="button" role="menuitemradio" data-theme-choice="ember" aria-checked="false"><span class="tt__swatch tt__swatch--ember"></span><span>Ember</span><span class="tt__check" aria-hidden="true">✓</span></button>
  </div>
</div>

<style>
  .tt { position: relative; display: inline-flex; font-family: var(--font-display); }
  .tt__trigger { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; padding: 0; border: 1px solid var(--border); border-radius: 50%; background: var(--surface); color: var(--ink); cursor: pointer; transition: transform .2s var(--ease), border-color .2s, box-shadow .2s; }
  .tt__trigger:hover, .tt__trigger[aria-expanded="true"] { border-color: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 10%, transparent); }
  .tt__trigger:active { transform: scale(.94); }
  .tt__trigger:focus-visible, .tt__menu button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .tt__current, .tt__swatch { display: inline-block; width: 1.18rem; height: 1.18rem; border: 2px solid color-mix(in srgb, var(--ink) 32%, transparent); border-radius: 50%; background: linear-gradient(135deg, var(--surface-2) 0 54%, var(--accent) 54%); }
  .tt__menu { position: absolute; z-index: 120; top: calc(100% + .85rem); right: 0; width: min(16rem, calc(100vw - 2rem)); padding: .7rem; border: 1px solid var(--border); border-radius: 1.45rem; background: var(--surface-solid); box-shadow: var(--shadow-lift); }
  .tt__menu[hidden] { display: none; }
  .tt__menu button { width: 100%; display: grid; grid-template-columns: 1.45rem 1fr 1.25rem; align-items: center; gap: .9rem; min-height: 3.1rem; padding: .5rem .7rem; border: 0; border-radius: .85rem; background: transparent; color: var(--ink-2); font: inherit; font-size: 1rem; font-weight: 600; letter-spacing: -.02em; text-align: left; cursor: pointer; transition: background .18s var(--ease), color .18s var(--ease); }
  .tt__menu button:hover, .tt__menu button[aria-checked="true"] { color: var(--ink); background: var(--surface-2); }
  .tt__check { color: var(--accent); font-size: 1.35rem; font-weight: 700; opacity: 0; transform: translateX(-.2rem); transition: opacity .18s var(--ease), transform .18s var(--ease); }
  .tt__menu button[aria-checked="true"] .tt__check { opacity: 1; transform: translateX(0); }
  .tt__swatch--void { background: linear-gradient(135deg, #000000 0 54%, #2be0c4 54%); }
  .tt__swatch--ember { background: linear-gradient(135deg, #000000 0 54%, #e0481d 54%); }
</style>

<script is:inline>
  (() => {
    const trigger = document.getElementById("theme-toggle");
    const menu = document.getElementById("theme-menu");
    const choices = [...document.querySelectorAll("[data-theme-choice]")];
    const setTheme = (next) => {
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("tv-theme", next); } catch (e) {}
      choices.forEach((choice) => choice.setAttribute("aria-checked", String(choice.dataset.themeChoice === next)));
    };
    setTheme(document.documentElement.getAttribute("data-theme") || "void");
    const close = () => { menu?.setAttribute("hidden", ""); trigger?.setAttribute("aria-expanded", "false"); };
    trigger?.addEventListener("click", () => {
      const isClosed = menu?.hasAttribute("hidden");
      if (isClosed) { menu?.removeAttribute("hidden"); trigger.setAttribute("aria-expanded", "true"); }
      else close();
    });
    choices.forEach((choice) => choice.addEventListener("click", () => { setTheme(choice.dataset.themeChoice || "void"); close(); trigger?.focus(); }));
    document.addEventListener("click", (event) => { if (!document.getElementById("theme-switcher")?.contains(event.target)) close(); });
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") { close(); trigger?.focus(); } });
  })();
</script>
