---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";

const commitments = [
  { k: "01", t: "Cross-industry depth", claim: "We reuse proven patterns, then adapt them to you.", ev: "We have seen similar review work in finance, healthcare and customs. We adapt the approach to your data and risk." },
  { k: "02", t: "Practical AI", claim: "We build tools people use every day.", ev: "We agree what success looks like before we build, then track it after launch." },
  { k: "03", t: "Trusted partner", claim: "We give advice that saves you money.", ev: "Sometimes the answer is a tool you already have, a process fix or no project at all. We will say so." },
  { k: "04", t: "Outcome-driven", claim: "We measure business results, not just model results.", ev: "We focus on the number that matters, such as review time, error rate or workload." },
];

const wont = [
  "Recommend a new build when a simpler fix will do.",
  "Call a test finished before people use it.",
  "Use numbers we cannot prove.",
];
---
<Base
  title="Why us: cross-industry, practical, outcome-driven AI | Truvantik"
  description="Why Truvantik: practical AI work, clear advice and results you can measure."
>
  <section class="why snap--auto" aria-labelledby="why-title">
    <div class="why__glow" aria-hidden="true"></div>
    <div class="wrap why__in">
      <header class="why__intro reveal">
        <p class="why__overline">Why Truvantik</p>
        <h1 id="why-title">Good AI needs good judgement.</h1>
        <p class="lead">We help you choose the right work, build it well and measure what changes.</p>
      </header>

      <div class="why__principles" data-principles>
        <div class="why__thread" aria-hidden="true"><span></span></div>
        {commitments.map((c, i) => (
          <article class:list={["why__principle", "reveal", { "is-active": i === 0 }]} data-principle data-index={i} tabindex="0">
            <div class="why__marker" aria-hidden="true">{c.k}</div>
            <div class="why__summary">
              <h2>{c.t}</h2>
              <p>{c.claim}</p>
            </div>
            <p class="why__evidence">{c.ev}</p>
          </article>
        ))}
      </div>

      <aside class="why__line reveal" style="--d:180ms" aria-label="What we will not do">
        <p>We don’t</p>
        <ul>
          {wont.map((w) => <li>{w}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .why { min-height: auto; scroll-snap-align: none; position: relative; overflow: clip; padding-block: clamp(6rem, 11vw, 10rem); }
  .why__glow { position: absolute; inset: 15% -18% auto auto; width: min(48rem, 66vw); aspect-ratio: 1; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 14%, transparent), transparent 68%); pointer-events: none; }
  .why__in { display: grid; grid-template-columns: minmax(15rem, .75fr) minmax(0, 1.65fr); column-gap: clamp(2rem, 7vw, 7rem); row-gap: clamp(3rem, 7vw, 6rem); }
  .why__intro { position: sticky; top: clamp(6.5rem, 12vh, 9rem); align-self: start; }
  .why__overline, .why__marker { font-family: var(--font-display); font-size: .76rem; font-weight: 650; letter-spacing: .12em; line-height: 1; text-transform: uppercase; }
  .why__overline { color: var(--accent); margin-bottom: 1.25rem; }
  .why__intro h1 { max-width: 10ch; margin-bottom: 1.1rem; font-size: var(--page-title); line-height: .96; }
  .why__intro .lead { max-width: 31ch; font-size: clamp(1rem, .94rem + .16vw, 1.12rem); }

  .why__principles { --active: 0; grid-column: 2; position: relative; }
  .why__thread { position: absolute; top: 0; bottom: 0; left: 1.25rem; width: 1px; background: var(--border); }
  .why__thread span { position: absolute; left: 50%; width: 11px; height: 11px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 14%, transparent); }
  .why__principle { display: grid; grid-template-columns: 3rem minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(1.1rem, 3vw, 3rem); padding: clamp(1.6rem, 3vw, 2.7rem) 0; border-top: 1px solid var(--rule); position: relative; transition: color .35s var(--ease), background .35s var(--ease); }
  .why__principle:last-child { border-bottom: 1px solid var(--rule); }
  .why__principle::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 58%); opacity: 0; transition: opacity .35s var(--ease); pointer-events: none; }
  .why__principle.is-active::before, .why__principle:hover::before, .why__principle:focus-visible::before { opacity: 1; }
  .why__principle > * { position: relative; }
  .why__marker { color: var(--ink-3); padding-left: 1.8rem; transition: color .3s var(--ease); }
  .why__principle.is-active .why__marker, .why__principle:hover .why__marker, .why__principle:focus-visible .why__marker { color: var(--accent); }
  .why__summary h2 { font-size: clamp(1.2rem, 1.5vw, 1.55rem); margin-bottom: .45rem; }
  .why__summary p { font-size: clamp(.95rem, .91rem + .12vw, 1.04rem); line-height: 1.4; color: var(--ink-2); max-width: 23ch; }
  .why__evidence { max-width: 43ch; color: var(--ink-2); font-size: clamp(.92rem, .88rem + .12vw, 1rem); line-height: 1.5; }

  .why__line { grid-column: 2; border-top: 1px solid var(--rule); display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: clamp(1rem, 2vw, 2rem); margin-top: clamp(1rem, 3vw, 2.5rem); padding-top: 1.1rem; align-items: start; }
  .why__line > p { padding-top: .18rem; color: var(--accent); font-family: var(--font-display); font-size: .72rem; font-weight: 650; letter-spacing: .08em; line-height: 1.2; text-transform: uppercase; }
  .why__line ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2.25rem); }
  .why__line li { position: relative; color: var(--ink-2); line-height: 1.4; font-size: clamp(.82rem, .79rem + .1vw, .92rem); padding-top: .8rem; border-top: 1px solid var(--border); }
  .why__line li::before { content: ""; position: absolute; top: -.09rem; left: 0; width: 1.15rem; height: 1px; background: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    .why__thread span { top: calc((var(--active) + .5) * 25% - 6px); transform: translateX(-50%); transition: top .55s cubic-bezier(.16, 1, .3, 1), box-shadow .35s var(--ease); }
    .why__principle:hover { transition-duration: .18s; }
  }
  @media (max-width: 900px) {
    .why__in { grid-template-columns: 1fr; }
    .why__intro { position: static; }
    .why__principles { grid-column: 1; }
    .why__line { grid-column: 1; grid-template-columns: 1fr; gap: .8rem; }
  }
  @media (max-width: 680px) {
    .why__principle { grid-template-columns: 3.6rem 1fr; gap: .7rem 1rem; }
    .why__thread { left: .9rem; }
    .why__marker { padding-left: 1.85rem; }
    .why__evidence { grid-column: 2; }
    .why__line ul { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
