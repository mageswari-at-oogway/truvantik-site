---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";

const services = [
  {
    id: "assessment", n: "01", phase: "Assess",
    title: "AI strategy & assessment",
    promise: "Find where AI creates measurable value before you commit budget.",
    body: "A structured assessment of your operations, data and constraints that ends in a ranked, costed roadmap, not a slide deck of possibilities.",
    who: ["Asked for an AI plan, unsure where to start", "Several competing ideas, no way to rank them", "Need a defensible business case before funding"],
    get: ["Opportunity register with a success measure per use case", "Data & systems readiness assessment", "Build / buy / integrate call per opportunity", "Sequenced roadmap with effort & cost ranges"],
    proof: "Assessments regularly end with fewer funded projects than the client expected.",
    visual: "rank",
  },
  {
    id: "build", n: "02", phase: "Build",
    title: "Custom AI product development",
    promise: "Build the product or feature end to end, and get it into users' hands.",
    body: "Engineering-led delivery of AI products and features, from data pipeline and model selection through interface, evaluation and launch.",
    who: ["The use case is clear and the business case is made", "You need a team that ships, not a prototype", "Users must be able to rely on it day one"],
    get: ["A working product, integrated and instrumented", "Evaluation set and success measure agreed up front", "Interface your users actually adopt", "Monitoring and handover built in"],
    proof: "We define what 'good enough to ship' means in numbers before building starts.",
    visual: "sprint",
  },
  {
    id: "integration", n: "03", phase: "Deploy",
    title: "AI integration & deployment",
    promise: "Move a working model into the systems and workflows people actually use.",
    body: "The unglamorous work that decides whether AI gets used: integration with core systems, access control, evaluation in production, and change management with the teams involved.",
    who: ["A model that works in a notebook, not the business", "A pilot stalled on integration or ownership", "Adoption is the blocker, not the model"],
    get: ["Integration with your core systems", "Access control and configurable data handling", "In-production evaluation and monitoring", "A named owner and a team that can run it"],
    proof: "If it is not integrated and being used, we do not consider the engagement done.",
    visual: "nodes",
  },
  {
    id: "advisory", n: "04", phase: "Ongoing",
    title: "Ongoing AI advisory",
    promise: "A trusted technical partner on retainer as your AI portfolio grows.",
    body: "Continuing advisory for teams that now own AI systems: architecture review, vendor and model decisions, evaluation discipline, and hiring the right people.",
    who: ["Your team owns AI systems and wants a sounding board", "Vendor and model decisions keep recurring", "You want evaluation discipline to stick"],
    get: ["Architecture and model review", "Vendor and build/buy decisions", "Evaluation practice your team keeps", "Help hiring the right people"],
    proof: "Advisory-grade rigor: clients bring real operational problems, not experiments.",
    visual: "orbit",
  },
];
---
<Base
  title="Services: AI consulting, build and advisory | Truvantik"
  description="Four service lines covering the full path: deciding what is worth building, building it, getting it into the workflow, and running it well afterwards."
>
  <!-- intro -->
  <section class="snap svc-intro gridbg">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">
      <p class="kicker reveal">Services</p>
      <h1 class="svc-intro__h reveal" style="--d:60ms">From first assessment<br />to <span class="grad-text">production.</span></h1>
      <p class="lead reveal" style="--d:140ms">Four service lines that cover the full path: deciding what is worth building, building it, getting it into the workflow, and running it well afterwards. Each is scoped around a business outcome.</p>
      <ol class="svc-nav reveal" style="--d:220ms">
        {services.map((s) => (
          <li><a href={`#${s.id}`}><span class="svc-nav__n">{s.n}</span>{s.title}<span class="svc-nav__ph">{s.phase}</span></a></li>
        ))}
      </ol>
    </div>
  </section>

  {services.map((s, i) => (
    <section class="snap svc" id={s.id}>
      <div class="wrap">
        <article class:list={["svc__card reveal", { "svc__card--flip": i % 2 === 1 }]}>
          <div class="svc__copy">
            <div class="svc__meta">
              <span class="svc__n">{s.n}</span>
              <span class="svc__phase">{s.phase}</span>
              <span class="svc__rule" aria-hidden="true"></span>
            </div>
            <h2>{s.title}</h2>
            <p class="svc__promise">{s.promise}</p>
            <p class="svc__body muted">{s.body}</p>
            <div class="svc__cols">
              <div class="svc__col">
                <h3 class="svc__sub">Who it's for</h3>
                <ul class="svc__list svc__list--who">{s.who.map((w) => <li>{w}</li>)}</ul>
              </div>
              <div class="svc__col">
                <h3 class="svc__sub">What you get</h3>
                <ul class="svc__list svc__list--check">{s.get.map((g) => <li>{g}</li>)}</ul>
              </div>
            </div>
            <p class="svc__proof">{s.proof}</p>
            <a href="/contact" class="btn btn--grad svc__cta" data-magnetic>Get a proposal for {s.phase.toLowerCase() === "ongoing" ? "advisory" : s.phase.toLowerCase()} <span class="arw">→</span></a>
          </div>

          <div class="svc__art" aria-hidden="true">
            <div class="viz" data-viz={s.visual}>
              {s.visual === "rank" && (
                <div class="viz-rank">
                  <span class="viz-t">Opportunities · ranked by value</span>
                  <div class="viz-bars">
                    <span class="rb rb--on" style="--w:100%"><em>Support triage</em></span>
                    <span class="rb rb--on" style="--w:86%"><em>Document review</em></span>
                    <span class="rb rb--cut" style="--w:70%"><em>Returns handling</em></span>
                    <span class="rb rb--cut" style="--w:56%"><em>Onboarding</em></span>
                    <span class="rb rb--cut" style="--w:42%"><em>Knowledge base</em></span>
                  </div>
                  <span class="viz-cap">Funded list, shorter than you arrived with</span>
                </div>
              )}
              {s.visual === "sprint" && (
                <div class="viz-sprint">
                  <span class="viz-t">Sprint 4 / 8 · build in progress</span>
                  <div class="viz-track"><b style="--p:52%"></b></div>
                  <div class="viz-chips">
                    <span class="sc sc--done">data</span>
                    <span class="sc sc--done">model</span>
                    <span class="sc sc--now">interface</span>
                    <span class="sc">evals</span>
                    <span class="sc">launch</span>
                  </div>
                  <span class="viz-cap">"Good enough to ship" defined in numbers up front</span>
                </div>
              )}
              {s.visual === "nodes" && (
                <div class="viz-nodes">
                  <span class="viz-t">Surfaced where people already work</span>
                  <svg class="nmap" viewBox="0 0 300 200">
                    <line class="nl" x1="150" y1="100" x2="54" y2="46"/>
                    <line class="nl" x1="150" y1="100" x2="250" y2="52"/>
                    <line class="nl" x1="150" y1="100" x2="248" y2="150"/>
                    <line class="nl" x1="150" y1="100" x2="58" y2="156"/>
                    <g class="nn nn--1"><rect x="20" y="32" width="60" height="28" rx="14"/><text x="50" y="50">CRM</text></g>
                    <g class="nn nn--2"><rect x="220" y="38" width="52" height="28" rx="14"/><text x="246" y="56">BI</text></g>
                    <g class="nn nn--3"><rect x="206" y="136" width="80" height="28" rx="14"/><text x="246" y="154">Ops tool</text></g>
                    <g class="nn nn--4"><rect x="24" y="142" width="66" height="28" rx="14"/><text x="57" y="160">Data</text></g>
                    <g class="nhub"><circle cx="150" cy="100" r="30"/><text x="150" y="106">AI</text></g>
                  </svg>
                </div>
              )}
              {s.visual === "orbit" && (
                <div class="viz-orbit">
                  <span class="viz-t">A partner as the portfolio grows</span>
                  <div class="viz-orbit__stage">
                    <div class="viz-orbit__ring"><i></i><i></i><i></i></div>
                    <div class="viz-orbit__ring viz-orbit__ring--2"><i></i><i></i></div>
                    <span class="viz-orbit__core">You</span>
                  </div>
                  <span class="viz-cap">On retainer, across every new build</span>
                </div>
              )}
            </div>
          </div>
        </article>
      </div>
    </section>
  ))}

  <CtaBand />
</Base>

<style>
  .svc-intro__h { margin: 1rem 0 1.4rem; }
  .svc-nav { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem; margin-top: 2.4rem; max-width: 760px; }
  .svc-nav a { display: flex; align-items: center; gap: 0.7rem; padding: 0.85em 1.1em; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); backdrop-filter: var(--glass); font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--ink); transition: border-color 0.2s, transform 0.25s var(--ease), box-shadow 0.25s; }
  [data-theme="bauhaus"] .svc-nav a { border-radius: 0; border-width: 1.5px; border-color: var(--ink); }
  .svc-nav a:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-card); }
  .svc-nav__n { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); }
  .svc-nav__ph { margin-left: auto; font-family: var(--font-mono); font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }

  /* ---- service card ---- */
  .svc__card {
    display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: stretch;
    background: var(--surface-solid); border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-card);
  }
  [data-theme="bauhaus"] .svc__card { border-width: 2px; }
  .svc__card--flip .svc__copy { order: 2; }
  .svc__copy { padding: clamp(1.8rem, 3.5vw, 3rem); align-self: center; }
  .svc__meta { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.1rem; }
  .svc__n { font-family: var(--font-mono); font-size: 1.1rem; color: var(--accent); font-weight: 500; }
  .svc__phase { font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-2); border: 1px solid var(--border); border-radius: 999px; padding: 0.35em 0.8em; }
  [data-theme="bauhaus"] .svc__phase { border-radius: 0; border-width: 1.5px; }
  .svc__rule { flex: 1; height: 1px; background: var(--border); }
  .svc__copy h2 { font-size: var(--step-3); letter-spacing: -0.025em; }
  .svc__promise { font-size: var(--step-1); color: var(--ink); margin: 0.9rem 0 0.7rem; line-height: 1.35; }
  .svc__body { font-size: 0.92rem; line-height: 1.55; }
  .svc__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem 2rem; margin: 1.8rem 0 1.6rem; }
  .svc__sub { font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); margin-bottom: 0.8rem; font-weight: 500; }
  .svc__list { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .svc__list li { position: relative; padding-left: 1.5rem; font-size: 0.88rem; color: var(--ink-2); line-height: 1.45; }
  .svc__list--who li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 6px; height: 6px; border-radius: 2px; background: var(--ink-3); }
  .svc__list--check li::before { content: "✓"; position: absolute; left: 0; top: 0; font-size: 0.8rem; color: var(--accent); font-weight: 700; }
  .svc__proof { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-2); border-left: 2px solid var(--accent); padding-left: 0.9rem; margin-bottom: 1.7rem; line-height: 1.5; }
  .svc__cta { text-transform: capitalize; }

  /* ---- art panel ---- */
  .svc__art { position: relative; background: var(--bg-2); border-left: 1px solid var(--border); display: grid; place-items: center; padding: clamp(1.6rem, 3vw, 2.4rem); overflow: hidden; }
  .svc__card--flip .svc__art { order: 1; border-left: 0; border-right: 1px solid var(--border); }
  .svc__art::before { content: ""; position: absolute; inset: 0; background: var(--grad-soft); opacity: 0.7; pointer-events: none; }
  .viz { position: relative; width: 100%; max-width: 340px; }
  .viz-t { display: block; font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 1rem; }
  .viz-cap { display: block; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3); margin-top: 1rem; }

  /* rank */
  .viz-bars { display: grid; gap: 0.55rem; }
  .rb { position: relative; height: 34px; width: 0; border-radius: var(--radius-sm); display: flex; align-items: center; padding: 0 0.7rem; overflow: hidden; }
  [data-theme="bauhaus"] .rb { border-radius: 0; }
  .rb em { font-family: var(--font-mono); font-style: normal; font-size: 0.7rem; white-space: nowrap; }
  .rb--on { background: var(--accent); } .rb--on em { color: var(--accent-ink); }
  .rb--cut { background: var(--surface-3); } .rb--cut em { color: var(--ink-3); }
  .svc__card.in .rb { width: var(--w); transition: width 0.8s var(--ease); }
  .svc__card.in .rb:nth-child(1) { transition-delay: 0.05s; }
  .svc__card.in .rb:nth-child(2) { transition-delay: 0.18s; }
  .svc__card.in .rb:nth-child(3) { transition-delay: 0.31s; }
  .svc__card.in .rb:nth-child(4) { transition-delay: 0.44s; }
  .svc__card.in .rb:nth-child(5) { transition-delay: 0.57s; }

  /* sprint */
  .viz-track { height: 12px; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
  [data-theme="bauhaus"] .viz-track { border-radius: 0; }
  .viz-track b { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 999px; }
  .svc__card.in .viz-track b { width: var(--p); transition: width 1s var(--ease) 0.2s; }
  .viz-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .sc { font-family: var(--font-mono); font-size: 0.7rem; padding: 0.35em 0.75em; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--ink-3); opacity: 0; transform: translateY(6px); }
  [data-theme="bauhaus"] .sc { border-radius: 0; }
  .sc--done { color: var(--ink-2); }
  .sc--now { color: var(--accent-ink); background: var(--accent); border-color: transparent; }
  .svc__card.in .sc { animation: chipIn 0.4s var(--ease) both; }
  .svc__card.in .sc:nth-child(1) { animation-delay: 0.5s; }
  .svc__card.in .sc:nth-child(2) { animation-delay: 0.65s; }
  .svc__card.in .sc:nth-child(3) { animation-delay: 0.8s; }
  .svc__card.in .sc:nth-child(4) { animation-delay: 0.95s; }
  .svc__card.in .sc:nth-child(5) { animation-delay: 1.1s; }
  @keyframes chipIn { to { opacity: 1; transform: none; } }

  /* nodes */
  .nmap { width: 100%; height: auto; overflow: visible; }
  .nl { stroke: var(--border-strong); stroke-width: 1.5; stroke-dasharray: 130; stroke-dashoffset: 130; }
  .svc__card.in .nl { animation: draw 0.6s var(--ease) both; }
  .svc__card.in .nl:nth-of-type(1) { animation-delay: 0.35s; }
  .svc__card.in .nl:nth-of-type(2) { animation-delay: 0.5s; }
  .svc__card.in .nl:nth-of-type(3) { animation-delay: 0.65s; }
  .svc__card.in .nl:nth-of-type(4) { animation-delay: 0.8s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .nn rect { fill: var(--surface-solid); stroke: var(--border-strong); stroke-width: 1.5; }
  [data-theme="bauhaus"] .nn rect { rx: 0; }
  .nn text { fill: var(--ink-2); font-family: var(--font-mono); font-size: 11px; text-anchor: middle; }
  .nn { opacity: 0; transform: scale(0.6); transform-box: fill-box; transform-origin: center; }
  .svc__card.in .nn { animation: pop 0.4s var(--ease-spring) both; }
  .svc__card.in .nn--1 { animation-delay: 0.5s; } .svc__card.in .nn--2 { animation-delay: 0.62s; }
  .svc__card.in .nn--3 { animation-delay: 0.74s; } .svc__card.in .nn--4 { animation-delay: 0.86s; }
  @keyframes pop { 0% { opacity: 0; transform: scale(0.6); } 70% { transform: scale(1.08); } 100% { opacity: 1; transform: scale(1); } }
  .nhub circle { fill: var(--accent); }
  .nhub text { fill: var(--accent-ink); font-family: var(--font-display); font-weight: 700; font-size: 15px; text-anchor: middle; }
  .nhub { opacity: 0; transform: scale(0); transform-box: fill-box; transform-origin: center; }
  .svc__card.in .nhub { animation: pop 0.5s var(--ease-spring) 0.15s both; }

  /* orbit */
  .viz-orbit__stage { position: relative; width: 220px; height: 220px; margin: 0.4rem auto; }
  .viz-orbit__ring { position: absolute; inset: 0; border: 1px dashed var(--border-strong); border-radius: 50%; animation: spin 24s linear infinite; }
  .viz-orbit__ring--2 { inset: 34px; border-style: solid; border-color: var(--border); animation: spin 16s linear infinite reverse; }
  [data-theme="bauhaus"] .viz-orbit__ring { border-radius: 0; }
  .viz-orbit__core { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 74px; height: 74px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-family: var(--font-display); font-weight: 700; z-index: 2; }
  [data-theme="bauhaus"] .viz-orbit__core { border-radius: 0; }
  .viz-orbit__ring i { position: absolute; width: 14px; height: 14px; border-radius: 50%; background: var(--surface-solid); border: 2px solid var(--accent); top: -7px; left: 50%; margin-left: -7px; }
  .viz-orbit__ring i:nth-child(2) { top: auto; bottom: -7px; }
  .viz-orbit__ring i:nth-child(3) { top: 50%; left: -7px; margin-top: -7px; }
  .viz-orbit__ring--2 i:nth-child(1) { top: -7px; } .viz-orbit__ring--2 i:nth-child(2) { top: auto; bottom: -7px; }
  [data-theme="bauhaus"] .viz-orbit__ring i { border-radius: 0; }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .rb { width: var(--w) !important; }
    .viz-track b { width: var(--p) !important; }
    .sc { opacity: 1 !important; transform: none !important; }
    .nl { stroke-dashoffset: 0 !important; }
    .nn, .nhub { opacity: 1 !important; transform: none !important; }
    .viz-orbit__ring { animation: none; }
  }

  @media (max-width: 900px) {
    .svc__card, .svc__card--flip { grid-template-columns: 1fr; }
    .svc__card--flip .svc__copy { order: 2; }
    .svc__card--flip .svc__art { order: 1; border-right: 0; border-bottom: 1px solid var(--border); }
    .svc__art { border-left: 0; border-bottom: 1px solid var(--border); }
    .svc__card:not(.svc__card--flip) .svc__art { order: 1; }
    .svc__card:not(.svc__card--flip) .svc__copy { order: 2; }
    .svc__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .svc__cols, .svc-nav { grid-template-columns: 1fr; } }
</style>
