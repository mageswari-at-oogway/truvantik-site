---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";

const services = [
  {
    id: "assessment", n: "01", phase: "Assess", cta: "assessment",
    title: "AI strategy & assessment",
    promise: "",
    body: "Assess your operations, data and constraints to produce a ranked, costed roadmap, not a slide deck of possibilities.",
    who: ["You have competing AI ideas and need to decide where to start", "You need a defensible business case before funding"],
    get: ["A ranked, costed opportunity roadmap with a clear delivery path for each use case", "Data & systems readiness assessment"],
    visual: "rank",
  },
  {
    id: "build", n: "02", phase: "Build", cta: "product development",
    title: "Custom AI product development",
    promise: "",
    body: "Engineering-led delivery of AI products and features, from data pipeline and model selection through interface, evaluation and launch.",
    who: ["The use case and business case are clear; you need a team that ships", "Your users need a product they can rely on from day one"],
    get: ["A working, integrated, instrumented product", "A clear evaluation set and success measure before building starts", "An interface users adopt, with monitoring and handover built in"],
    visual: "sprint",
  },
  {
    id: "integration", n: "03", phase: "Deploy", cta: "deployment",
    title: "AI integration & deployment",
    promise: "",
    body: "The unglamorous work that decides whether AI gets used: integration with core systems, access control, evaluation in production, and change management with the teams involved.",
    who: ["Your model works in a notebook, or a pilot has stalled on integration", "Adoption, not model quality, is the blocker"],
    get: ["Integration with your core systems, access control, and configurable data handling", "In-production evaluation and monitoring", "A named owner and a team that can run it"],
    visual: "nodes",
  },
  {
    id: "advisory", n: "04", phase: "Ongoing", cta: "advisory",
    title: "Ongoing AI advisory",
    promise: "",
    body: "Continuing advisory for teams that now own AI systems: architecture review, vendor and model decisions, evaluation discipline, and hiring the right people.",
    who: ["Your team owns AI systems and needs independent technical guidance", "Vendor and model decisions keep recurring, and you want evaluation discipline to stick"],
    get: ["Architecture, model, and build/buy review", "A durable evaluation practice your team keeps", "Help hiring the right people"],
    visual: "orbit",
  },
];
---
<Base
  title="Services: AI consulting, build and advisory | Truvantik"
  description="Four service lines covering the full path: deciding what is worth building, building it, getting it into the workflow, and running it well afterwards."
>
  <!-- intro -->
  <section class="snap svc-intro gridbg">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap svc-intro__layout">
      <div class="svc-intro__lead">
        <h1 class="svc-intro__h reveal">From first assessment<br />to <span class="grad-text">production.</span></h1>
        <p class="lead reveal" style="--d:80ms">Four service lines that cover the full path: deciding what is worth building, building it, getting it into the workflow, and running it well afterwards. Each is scoped around a business outcome.</p>
      </div>
      <ol class="svc-nav reveal" style="--d:160ms" aria-label="Service journey">
        {services.map((s) => (
          <li><a href={`#${s.id}`}><span class="svc-nav__n">{s.n}</span><span class="svc-nav__title">{s.title}</span><span class="svc-nav__ph">{s.phase}</span></a></li>
        ))}
      </ol>
    </div>
  </section>

  {services.map((s, i) => (
    <section class="svc" id={s.id}>
      <div class="wrap">
        <article class:list={["svc__chapter reveal", { "svc__chapter--offset": i % 2 === 1 }]}>
          <div class="svc__copy">
            <header class="svc__header">
              <div class="svc__meta">
              <span class="svc__n">{s.n}</span>
              <span class="svc__phase">{s.phase}</span>
              </div>
              <h2>{s.title}</h2>
              {s.promise && <p class="svc__promise">{s.promise}</p>}
            </header>
            <div class="svc__story">
            {s.body && <p class="svc__body muted">{s.body}</p>}
            <div class="svc__cols">
              <div class="svc__col">
                <h3 class="svc__sub">Who it's for</h3>
                <ul class="svc__list svc__list--who">{s.who.map((w) => <li>{w}</li>)}</ul>
              </div>
              <div class="svc__col">
                <h3 class="svc__sub">What you get</h3>
                <ul class="svc__list svc__list--check">{s.get.map((g) => <li>{g}</li>)}</ul>
              </div>
            </div>
            <a href="/contact" class="btn btn--grad svc__cta" data-magnetic>Get a proposal for {s.cta} <span class="arw">→</span></a>
            </div>
          </div>

          <figure class="svc__art" aria-hidden="true">
            <div class="viz" data-viz={s.visual}>
              {s.visual === "rank" && (
                <div class="viz-rank">
                  <span class="viz-t">Opportunities · ranked by value</span>
                  <div class="viz-bars">
                    <span class="rb rb--on" style="--w:100%"><em>Support triage</em></span>
                    <span class="rb rb--on" style="--w:86%"><em>Document review</em></span>
                    <span class="rb rb--cut" style="--w:70%"><em>Returns handling</em></span>
                    <span class="rb rb--cut" style="--w:56%"><em>Onboarding</em></span>
                    <span class="rb rb--cut" style="--w:42%"><em>Knowledge base</em></span>
                  </div>
                  <span class="viz-cap">Funded list, shorter than you arrived with</span>
                </div>
              )}
              {s.visual === "sprint" && (
                <div class="viz-sprint">
                  <span class="viz-t">Sprint 4 / 8 · build in progress</span>
                  <div class="viz-track"><b style="--p:52%"></b></div>
                  <div class="viz-chips">
                    <span class="sc sc--done">data</span>
                    <span class="sc sc--done">model</span>
                    <span class="sc sc--now">interface</span>
                    <span class="sc">evals</span>
                    <span class="sc">launch</span>
                  </div>
                  <span class="viz-cap">"Good enough to ship" defined in numbers up front</span>
                </div>
              )}
              {s.visual === "nodes" && (
                <div class="viz-nodes">
                  <span class="viz-t">Surfaced where people already work</span>
                  <svg class="nmap" viewBox="0 0 320 210" role="img" aria-label="AI connects CRM and data to business intelligence and operations tools">
                    <text class="ngroup" x="24" y="24">INPUTS</text>
                    <text class="ngroup" x="296" y="24" text-anchor="end">OUTPUTS</text>
                    <path class="nl" d="M74 64 H116 L140 94"/>
                    <path class="nl" d="M74 154 H116 L140 116"/>
                    <path class="nl" d="M180 94 L204 64 H246"/>
                    <path class="nl" d="M180 116 L204 154 H246"/>
                    <g class="nn nn--1"><path d="M64 60 L68 64 L64 68 L60 64 Z"/><text x="24" y="68">CRM</text></g>
                    <g class="nn nn--2"><path d="M64 150 L68 154 L64 158 L60 154 Z"/><text x="24" y="158">Data</text></g>
                    <g class="nn nn--3"><path d="M256 60 L260 64 L256 68 L252 64 Z"/><text x="270" y="68">BI</text></g>
                    <g class="nn nn--4"><path d="M256 150 L260 154 L256 158 L252 154 Z"/><text x="270" y="158">Ops tool</text></g>
                    <g class="nhub"><path d="M160 78 L182 105 L160 132 L138 105 Z"/><text x="160" y="109" text-anchor="middle">AI</text></g>
                  </svg>
                </div>
              )}
              {s.visual === "orbit" && (
                <div class="viz-cadence">
                  <span class="viz-t">A partner as the portfolio grows</span>
                  <div class="viz-cadence__lines">
                    <span>Architecture review</span>
                    <span>Decision support</span>
                    <span>Evaluation discipline</span>
                  </div>
                  <span class="viz-cap">On retainer, across every new build</span>
                </div>
              )}
            </div>
          </figure>
        </article>
      </div>
    </section>
  ))}

  <CtaBand />
</Base>

<style>
  .svc-intro__layout { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr); gap: clamp(2.5rem, 8vw, 9rem); align-items: end; }
  .svc-intro__h { margin: 0 0 1.5rem; max-width: 13ch; }
  .svc-nav { list-style: none; padding: 0 0 0 1.35rem; display: grid; gap: 1.1rem; margin: 0; border-left: 1px solid var(--accent); }
  .svc-nav a { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0 0.75rem; font-family: var(--font-display); font-weight: 600; font-size: 1rem; color: var(--ink); transition: color 0.2s; }
  .svc-nav a:hover { color: var(--accent); }
  .svc-nav__n { grid-row: span 2; font-size: 0.78rem; color: var(--accent); padding-top: 0.2rem; }
  .svc-nav__title { line-height: 1.25; }
  .svc-nav__ph { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin-top: 0.2rem; }

  /* ---- continuous service chapters ---- */
  .svc { min-height: auto; scroll-snap-align: none; padding-block: clamp(5rem, 11vw, 10rem); border-top: 1px solid var(--rule); }
  .svc__chapter { display: grid; grid-template-columns: minmax(12rem, 0.65fr) minmax(22rem, 1.2fr) minmax(14rem, 0.7fr); gap: clamp(2rem, 4vw, 5rem); align-items: start; }
  .svc__copy { display: contents; }
  .svc__header { grid-column: 1; position: sticky; top: 8rem; }
  .svc__story { grid-column: 2; }
  .svc__meta { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.5rem; }
  .svc__n { font-family: var(--font-mono); font-size: 1.1rem; color: var(--accent); font-weight: 500; }
  .svc__phase { font-family: var(--font-display); font-size: 0.75rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .svc__copy h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.55rem + 1.45vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 11ch;
  }
  .svc__promise {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.08rem + 0.42vw, 1.5rem);
    font-weight: 500;
    color: var(--ink);
    margin: 1.15rem 0 0.85rem;
    line-height: 1.24;
    max-width: 33ch;
  }
  .svc__body {
    font-size: clamp(0.98rem, 0.94rem + 0.14vw, 1.06rem);
    color: var(--ink-2);
    line-height: 1.62;
    max-width: 58ch;
  }
  .svc__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 2.5rem; margin: 2.5rem 0; }
  .svc__sub { font-family: var(--font-display); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin-bottom: 0.85rem; font-weight: 650; }
  .svc__list { list-style: none; padding: 0; display: grid; gap: 0.62rem; }
  .svc__list li { position: relative; padding-left: 1.5rem; font-size: clamp(0.9rem, 0.87rem + 0.1vw, 0.98rem); color: var(--ink-2); line-height: 1.48; }
  .svc__list--who li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 6px; height: 6px; border-radius: 2px; background: var(--ink-3); }
  .svc__list--check li::before { content: "✓"; position: absolute; left: 0; top: 0; font-size: 0.8rem; color: var(--accent); font-weight: 700; }
  .svc__cta { text-transform: capitalize; }

  /* ---- diagrams sit openly in the page canvas ---- */
  .svc__art { grid-column: 3; position: sticky; top: 10rem; min-height: 17rem; display: grid; place-items: center; margin: 0; }
  .svc__chapter--offset .svc__art { top: 15rem; }
  .svc__art::before { content: none; }
  .viz { position: relative; width: 100%; max-width: 340px; }
  .viz-t { display: block; font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 1rem; }
  .viz-cap { display: block; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3); margin-top: 1rem; }

  /* rank */
  .viz-rank { padding: 0.5rem 0; }
  .viz-bars { display: grid; gap: 0.85rem; counter-reset: opportunity; }
  .rb { position: relative; height: 2.2rem; width: 100%; display: flex; align-items: center; padding-left: 2.25rem; transform: none; opacity: 1; }
  .rb::before { counter-increment: opportunity; content: "0" counter(opportunity); position: absolute; left: 0; font-family: var(--font-display); font-size: 0.68rem; color: var(--ink-3); }
  .rb::after { content: ""; position: absolute; left: 2.25rem; bottom: 0; width: calc(var(--w) - 2.25rem); height: 1px; background: var(--border-strong); transform-origin: left; }
  .rb em { position: relative; z-index: 1; font-family: var(--font-display); font-style: normal; font-size: 0.88rem; font-weight: 500; white-space: nowrap; color: var(--ink-2); }
  .rb--on::after { height: 3px; background: var(--accent); }
  .rb--on em { color: var(--ink); }
  .rb--cut { opacity: 0.55; }
  .svc__chapter.in .rb { opacity: 1; transform: none; transition: opacity 0.5s var(--ease), transform 0.5s var(--ease); }
  .svc__chapter.in .rb:nth-child(1) { transition-delay: 0.05s; }
  .svc__chapter.in .rb:nth-child(2) { transition-delay: 0.18s; }
  .svc__chapter.in .rb:nth-child(3) { transition-delay: 0.31s; }
  .svc__chapter.in .rb:nth-child(4) { transition-delay: 0.44s; }
  .svc__chapter.in .rb:nth-child(5) { transition-delay: 0.57s; }

  /* sprint */
  .viz-track { height: 1px; background: var(--border-strong); overflow: visible; margin-top: 1.8rem; }
  .viz-track b { display: block; height: 3px; width: var(--p); background: var(--accent); transform: scaleX(1); transform-origin: left; }
  .svc__chapter.in .viz-track b { transform: scaleX(1); transition: transform 1s var(--ease) 0.2s; }
  .viz-chips { display: flex; justify-content: space-between; gap: 0.35rem; margin-top: 0.85rem; }
  .sc { position: relative; font-family: var(--font-display); font-size: 0.68rem; color: var(--ink-3); opacity: 1; transform: none; }
  .sc::before { content: ""; display: block; width: 5px; height: 5px; margin-bottom: 0.45rem; background: var(--border-strong); transform: rotate(45deg); }
  .sc--done { color: var(--ink-2); }
  .sc--done::before, .sc--now::before { background: var(--accent); }
  .sc--now { color: var(--accent); font-weight: 650; }
  .svc__chapter.in .sc { animation: chipIn 0.4s var(--ease) both; }
  .svc__chapter.in .sc:nth-child(1) { animation-delay: 0.5s; }
  .svc__chapter.in .sc:nth-child(2) { animation-delay: 0.65s; }
  .svc__chapter.in .sc:nth-child(3) { animation-delay: 0.8s; }
  .svc__chapter.in .sc:nth-child(4) { animation-delay: 0.95s; }
  .svc__chapter.in .sc:nth-child(5) { animation-delay: 1.1s; }
  @keyframes chipIn { to { opacity: 1; transform: none; } }

  /* nodes */
  .nmap { display: block; width: 100%; height: auto; max-width: 320px; max-height: 210px; margin: 0 auto; overflow: visible; }
  .ngroup { fill: var(--ink-3); font-family: var(--font-display); font-size: 8px; font-weight: 650; letter-spacing: 1.2px; }
  .nl { fill: none; stroke: var(--border-strong); stroke-width: 1.25; stroke-dasharray: 130; stroke-dashoffset: 0; }
  .svc__chapter.in .nl { animation: draw 0.6s var(--ease) both; }
  .svc__chapter.in .nl:nth-of-type(1) { animation-delay: 0.35s; }
  .svc__chapter.in .nl:nth-of-type(2) { animation-delay: 0.5s; }
  .svc__chapter.in .nl:nth-of-type(3) { animation-delay: 0.65s; }
  .svc__chapter.in .nl:nth-of-type(4) { animation-delay: 0.8s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .nn path { fill: var(--ink-3); }
  .nn text { fill: var(--ink-2); font-family: var(--font-display); font-size: 12px; font-weight: 500; }
  .nn { opacity: 1; transform: none; transform-box: fill-box; transform-origin: center; }
  .svc__chapter.in .nn { animation: pop 0.4s var(--ease) both; }
  .svc__chapter.in .nn--1 { animation-delay: 0.5s; } .svc__chapter.in .nn--2 { animation-delay: 0.62s; }
  .svc__chapter.in .nn--3 { animation-delay: 0.74s; } .svc__chapter.in .nn--4 { animation-delay: 0.86s; }
  @keyframes pop { 0% { opacity: 0; transform: scale(0.6); } 70% { transform: scale(1.08); } 100% { opacity: 1; transform: scale(1); } }
  .nhub path { fill: var(--accent); }
  .nhub text { fill: var(--accent-ink); font-family: var(--font-display); font-weight: 700; font-size: 15px; text-anchor: middle; }
  .nhub { opacity: 1; transform: none; transform-box: fill-box; transform-origin: center; }
  .svc__chapter.in .nhub { animation: pop 0.5s var(--ease) 0.15s both; }

  /* advisory cadence */
  .viz-cadence__lines { display: grid; gap: 1.1rem; margin: 1.4rem 0; }
  .viz-cadence__lines span { position: relative; padding-left: 1.15rem; font-family: var(--font-display); font-size: 0.9rem; color: var(--ink-2); }
  .viz-cadence__lines span::before { content: ""; position: absolute; left: 0; top: 0.45em; width: 7px; height: 7px; background: var(--accent); transform: rotate(45deg); }
  .viz-cadence__lines span::after { content: ""; position: absolute; left: 0; top: calc(0.45em + 10px); width: 1px; height: 1.15rem; background: var(--border-strong); }
  .viz-cadence__lines span:last-child::after { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .rb, .viz-track b { transform: none !important; }
    .sc { opacity: 1 !important; transform: none !important; }
    .nl { stroke-dashoffset: 0 !important; }
    .nn, .nhub { opacity: 1 !important; transform: none !important; }
  }

  @media (max-width: 900px) {
    .svc-intro__layout, .svc__chapter { grid-template-columns: 1fr; }
    .svc-intro__layout { gap: 3rem; }
    .svc-nav { max-width: 34rem; }
    .svc__header, .svc__story, .svc__art { grid-column: 1; position: static; }
    .svc__art, .svc__chapter--offset .svc__art { min-height: 15rem; margin-block: 0.5rem 0; order: 2; }
    .svc__story { order: 3; }
    .svc__header { order: 1; }
    .svc__copy h2 { max-width: 14ch; }
    .svc__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .svc__cols { grid-template-columns: 1fr; gap: 1.8rem; } .svc-nav { padding-left: 1rem; } }
</style>
