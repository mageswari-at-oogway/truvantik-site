---
import Base from "../layouts/Base.astro";
import BrandGraphic from "../components/BrandGraphic.astro";

const commitments = [
  { k: "01", t: "Cross-industry depth", claim: "Expertise transfers rather than resetting with every client.", ev: "Document-heavy review looks the same in underwriting, clinical intake and customs clearance. We bring the pattern and adapt it — not rediscover it on your budget." },
  { k: "02", t: "Practical AI", claim: "Solutions that ship and get used, not proofs-of-concept that stall.", ev: "We define what “good enough to ship” means in numbers before building, and instrument it in production so adoption is measured, not assumed." },
  { k: "03", t: "Trusted partner", claim: "Advisory-grade rigor on real problems, not experiments.", ev: "We’ll tell you to buy a tool, fix a process, or stop a project when that’s right — assessments often end with a shorter funded list than you arrived with." },
  { k: "04", t: "Outcome-driven", claim: "Framed around a measurable business result, not technology for its own sake.", ev: "Scope starts from the business measure — review time, exception rate, service load — and the same measure is reported after launch." },
];

const entries = [
  { id: "unsure", tab: "Not sure where AI fits", body: "You have been asked for a plan, or you suspect there is value here but cannot yet name it. Begin with an assessment that ends in a ranked, costed roadmap.", flow: "Assessment → Ranked roadmap", time: "4–6 weeks", tag: "Start here" },
  { id: "build", tab: "You know what to build", body: "The use case is clear and the business case is made. You need a team that can take it from data to a deployed product your users rely on.", flow: "Build → Shipped product", time: "3–5 months", tag: "Ready to build" },
  { id: "stalled", tab: "Your pilot has stalled", body: "It works in a demo but not in the business. Usually the blocker is integration, ownership or adoption rather than the model itself.", flow: "Unstick → Production system", time: "6–8 weeks", tag: "Unstick it" },
];

const phases = [
  { n: "01", k: "Assess", d: "Understand the work, the data and the constraints. Decide what is worth building and what is not.", note: "The point — reduce the problem to its essential elements." },
  { n: "02", k: "Build", d: "Build the smallest system that proves the outcome, then harden it against real data and real users.", note: "The line — the shortest path through the build, reviewed with you directly." },
  { n: "03", k: "Deploy", d: "Deploy into your stack, measure it against the outcome, and hand over the knowledge to keep it running.", note: "The plane — the system running whole: deployed, observed, documented, handed over." },
];
---
<Base
  title="Truvantik — AI strategy, shipped. Results, not prototypes."
  description="Truvantik turns AI strategy into deployed, used-in-production systems — one partner from first assessment to live deployment, with nothing between you and the people who build it."
>
  <!-- ============ 1 · HERO ============ -->
  <section class="snap hero gridbg">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap hero__in">
      <div class="hero__copy">
        <p class="kicker reveal">Your true advantage</p>
        <h1 class="hero__h reveal" style="--d:60ms">
          AI strategy,<br /><span class="grad-text">shipped.</span><br />Results, not prototypes.
        </h1>
        <p class="lead reveal" style="--d:140ms">
          Most AI stalls as a demo. We build the version that reaches production and gets used — and you
          work with the engineers doing it, not account managers.
        </p>
        <div class="hero__cta reveal" style="--d:220ms">
          <a href="/contact" class="btn btn--grad" data-magnetic>Start with a free assessment <span class="arw">→</span></a>
          <a href="#approach" class="btn btn--ghost">Explore our approach</a>
        </div>
        <p class="hero__proof reveal" style="--d:300ms">
          <span>One partner</span><b>·</b><span>Assess → Build → Deploy</span><b>·</b><span>Engineering-led</span>
        </p>
      </div>
      <div class="hero__art reveal" style="--d:180ms">
        <BrandGraphic compact id="hero-graphic" />
      </div>
    </div>
    <a href="#why" class="scroll-cue" aria-hidden="true"><span></span>Scroll</a>
  </section>

  <!-- ============ 2 · DIFFERENTIATORS ============ -->
  <section class="snap why" id="why">
    <div class="wrap why__in">
      <div class="why__lead">
        <p class="kicker reveal">Why Truvantik</p>
        <h2 class="reveal" style="--d:60ms">Most AI stalls at the demo.<br />We build the part after.</h2>
        <p class="lead reveal" style="--d:120ms">The gap is rarely the model — it is integration, ownership, evaluation and adoption. That is what we are built around.</p>
        <a href="/why-truvantik" class="why__more reveal" style="--d:200ms">Why teams choose us <span class="arw">→</span></a>
      </div>
      <ol class="why__list">
        {commitments.map((c, i) => (
          <li class="why__item reveal card" style={`--d:${140 + i * 80}ms`}>
            <span class="why__k">{c.k}</span>
            <div class="why__body">
              <h3>{c.t}</h3>
              <p class="why__claim">{c.claim}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 4 · ENTRY POINTS ============ -->
  <section class="snap entry" id="approach">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">Pick your starting point</p>
        <h2>Where are you today?</h2>
        <p class="lead">Most conversations start in one of three places. Each leads to a different first engagement.</p>
      </div>
      <div class="entry__cards reveal" style="--d:100ms">
        {entries.map((e, i) => (
          <article class:list={["ep card", { "ep--rec": i === 0 }]} style={`--d:${120 + i * 90}ms`}>
            <div class="ep__top">
              <span class="ep__tag">{e.tag}</span>
              <span class="ep__time">{e.time}</span>
            </div>
            <h3 class="ep__t">{e.tab}</h3>
            <p class="ep__b muted">{e.body}</p>
            <a href="/contact" class="ep__cta">
              <span class="ep__flow">{e.flow}</span>
              <span class="arw" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 5 · ASSESS · BUILD · DEPLOY ============ -->
  <section class="snap flow gridbg" id="flow">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">How we work</p>
        <h2>Assess · Build · Deploy</h2>
        <p class="lead">Every engagement sits somewhere on the same three phases. Service steps are the detail inside them.</p>
      </div>
      <ol class="flow__track reveal" style="--d:120ms" data-flow>
        <span class="flow__rail" aria-hidden="true"><span class="flow__rail-fill" data-rail></span></span>
        {phases.map((p) => (
          <li class="flow__step">
            <span class="flow__node" aria-hidden="true">{p.n}</span>
            <h3 class="flow__k">{p.k}</h3>
            <p class="muted flow__d">{p.d}</p>
            <p class="flow__note">{p.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 6 · PROOF POINT ============ -->
  <section class="snap proof" id="proof">
    <div class="wrap proof__in">
      <div class="proof__copy reveal">
        <p class="kicker">Featured proof point</p>
        <h2>Kron Health — a digital clinic platform.</h2>
        <div class="proof__tags">
          <span class="pill">Healthcare</span>
          <span class="pill">Completed engagement</span>
          <span class="pill">Built with 3BP Labs</span>
        </div>
        <p class="lead">A clinic platform where AI-assisted workflows had to fit clinical reality: careful handling of patient information, clinician review at the right point, and behaviour that is auditable rather than opaque.</p>
        <a href="/work" class="btn btn--ghost">Read our case studies <span class="arw">→</span></a>
        <p class="proof__note muted">Separate brand: Kron Health is its own product brand, built by our team with 3BP Labs. It is not a Truvantik service line.</p>
      </div>
      <div class="proof__art reveal" style="--d:120ms" aria-hidden="true">
        <div class="kron card" id="proof-draft">
          <div class="kron__head">
            <span class="kron__k">Patient case · live workflow</span>
            <span class="kron__badge"><span class="dot2"></span>Auditable</span>
          </div>
          <ol class="kron__flow">
            <span class="kspine" aria-hidden="true"><span class="kspine__fill"></span></span>

            <li class="kstep kstep--1">
              <span class="kstep__ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 19a6.5 6.5 0 0 1 13 0"/></svg>
              </span>
              <div class="kstep__b"><b>Patient intake</b><span>Symptoms &amp; history captured</span></div>
            </li>

            <li class="kstep kstep--2">
              <span class="kstep__ico"><b class="kstep__ai">AI</b></span>
              <div class="kstep__b"><b>AI-assisted note</b>
                <span class="kstep__lines"><i style="--w:100%"></i><i style="--w:80%"></i><i style="--w:64%"></i></span>
              </div>
            </li>

            <li class="kstep kstep--3">
              <span class="kstep__ico">
                <svg class="kstep__tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 L10 17.5 L19 7.5"/></svg>
              </span>
              <div class="kstep__b"><b>Clinician review</b><span>Approved at the right point</span></div>
            </li>

            <li class="kstep kstep--4">
              <span class="kstep__ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/></svg>
              </span>
              <div class="kstep__b"><b>Into the record</b><span>Every step logged &amp; auditable</span></div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 7 · FINAL CTA ============ -->
  <section class="snap cta gridbg">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap cta__in reveal">
      <div class="cta__mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="72" height="72"><defs><clipPath id="ctaclip"><rect x="10" y="10" width="44" height="44" rx="9" transform="rotate(45 32 32)"/></clipPath></defs><g clip-path="url(#ctaclip)"><rect width="64" height="64" fill="var(--logo-face)"/><path d="M40 0 L64 24 L64 64 L40 64 Z" fill="var(--logo-corner)"/></g><path d="M32 15 L47 31 H38.5 V51 H25.5 V31 H17 Z" fill="var(--logo-mark)"/><rect x="10" y="10" width="44" height="44" rx="9" transform="rotate(45 32 32)" fill="none" stroke="var(--logo-stroke)" stroke-width="3"/></svg>
      </div>
      <h2>Let's find your true advantage.</h2>
      <p class="lead">A 30-minute call is usually enough to tell whether there is a real opportunity here, and what the first step should be.</p>
      <div class="cta__row">
        <a href="/contact" class="btn btn--grad" data-magnetic>Start with a free assessment <span class="arw">→</span></a>
        <a href="/services" class="btn btn--ghost">See how we work</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const el = document.getElementById("proof-draft");
      if (!el) return;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) { el.classList.add("play"); return; }
      let timer;
      const cycle = () => {
        el.classList.add("noanim");
        el.classList.remove("play");
        void el.offsetWidth;
        el.classList.remove("noanim");
        el.classList.add("play");
      };
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (e.isIntersecting) { cycle(); timer = setInterval(cycle, 5600); }
          else { clearInterval(timer); }
        });
      }, { threshold: 0.4 });
      io.observe(el);
    })();
  </script>
</Base>

<style>
  /* ---- hero ---- */
  .hero { padding-top: 72px; }
  .hero__in { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero__copy { display: grid; }
  .hero__h { margin: 1.4rem 0 0; }
  .hero .lead { font-size: var(--step-0); max-width: 46ch; margin-top: 1.5rem; }
  .hero__cta { display: flex; gap: 0.85rem; flex-wrap: nowrap; margin-top: 2.25rem; }
  .hero__cta .btn { white-space: nowrap; }
  .hero__proof { margin-top: 2.25rem; }
  @media (max-width: 520px) { .hero__cta { flex-wrap: wrap; } }
  .hero__proof { display: flex; align-items: center; gap: 0.7rem; font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.03em; color: var(--ink-3); flex-wrap: wrap; }
  .hero__proof b { color: var(--accent); }
  .scroll-cue { position: absolute; bottom: 1.6rem; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 0.5em; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }
  .scroll-cue span { width: 1px; height: 26px; background: linear-gradient(var(--accent), transparent); animation: cue 1.8s var(--ease-in-out) infinite; }
  @keyframes cue { 0%,100% { opacity: 0.3; transform: scaleY(0.7); } 50% { opacity: 1; transform: scaleY(1); } }

  /* ---- why ---- */
  .why__in { display: grid; grid-template-columns: 0.88fr 1.12fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .why__lead h2 { margin: 1rem 0 1.1rem; }
  .why__lead { position: sticky; top: 96px; }
  .why__wont { margin-top: 1.9rem; padding-top: 1.4rem; border-top: 1px solid var(--border); }
  .why__wont-h { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); }
  .why__wont ul { list-style: none; padding: 0; margin: 0.9rem 0 0; display: grid; gap: 0.65rem; }
  .why__wont li { display: grid; grid-template-columns: auto 1fr; gap: 0.65rem; align-items: start; font-size: 0.9rem; color: var(--ink-2); line-height: 1.4; }
  .why__x { color: var(--highlight); font-weight: 700; }
  .why__list { list-style: none; padding: 0; display: grid; gap: 0.7rem; }
  .why__item { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; padding: 1.1rem 1.25rem; transition: border-color 0.25s var(--ease), transform 0.25s var(--ease); }
  .why__item h3 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .why__claim { color: var(--ink); font-weight: 500; font-size: 0.95rem; margin-bottom: 0.45rem; }
  .why__ev { font-size: 0.85rem; line-height: 1.5; }
  .why__k { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); padding-top: 0.25rem; }
  .why__item:hover { border-color: var(--accent); transform: translateX(4px); }
  .why__more { display: inline-flex; align-items: center; gap: 0.5em; margin-top: 1.8rem; font-family: var(--font-display); font-weight: 600; color: var(--accent); }
  .why__more .arw { transition: transform 0.25s var(--ease); }
  .why__more:hover .arw { transform: translateX(4px); }
  @media (max-width: 860px) { .why__lead { position: static; } }

  /* ---- board section ---- */
  .board-sec__art { margin-top: 2.4rem; max-width: 1000px; margin-inline: auto; width: 100%; }

  /* ---- entry ---- */
  .entry__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.4rem; }
  .ep { display: flex; flex-direction: column; gap: 0.8rem; padding: 1.6rem; transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s; }
  .ep:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: var(--shadow-lift); }
  .ep--rec { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .ep__top { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; }
  .ep__tag { font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); }
  .ep__time { font-family: var(--font-mono); font-size: 0.66rem; color: var(--ink-3); white-space: nowrap; }
  .ep__t { font-size: var(--step-2); letter-spacing: -0.02em; }
  .ep__b { font-size: 0.92rem; line-height: 1.55; flex: 1; }
  .ep__cta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--ink); border-top: 1px solid var(--border); padding-top: 0.95rem; margin-top: 0.2rem; }
  .ep__flow { color: var(--ink); }
  .ep__cta .arw { color: var(--accent); transition: transform 0.25s var(--ease); flex: none; }
  .ep:hover .ep__cta .arw { transform: translateX(4px); }

  /* ---- flow ---- */
  .flow__track { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; margin-top: 3rem; position: relative; }
  .flow__rail { position: absolute; top: 22px; left: 8%; right: 8%; height: 2px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .flow__rail-fill { position: absolute; inset: 0; width: 0; background: linear-gradient(90deg, var(--accent), var(--highlight)); transition: width 1.4s var(--ease); }
  .flow__track.in .flow__rail-fill { width: 100%; }
  .flow__step { display: grid; gap: 0.5rem; position: relative; }
  .flow__node { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: var(--surface); border: 1px solid var(--border-strong); font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); position: relative; z-index: 1; }
  [data-theme="bauhaus"] .flow__node { border-radius: 0; border-width: 1.5px; }
  .flow__k { font-size: var(--step-2); margin-top: 0.3rem; }
  .flow__note { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-3); line-height: 1.5; }

  /* ---- proof ---- */
  .proof__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .proof__copy h2 { margin: 1rem 0 1.1rem; }
  .proof__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.3rem; }
  .proof__copy .btn { margin-top: 1.7rem; }
  .proof__note { font-size: 0.82rem; margin-top: 1.5rem; max-width: 46ch; padding-left: 0.9rem; border-left: 2px solid var(--border-strong); }

  /* Kron Health — clinical workflow that activates step by step */
  .kron { padding: 1.5rem 1.6rem; display: grid; gap: 1.2rem; }
  .kron__head { display: flex; align-items: center; justify-content: space-between; }
  .kron__k { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }
  .kron__badge { display: inline-flex; align-items: center; gap: 0.45em; font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
  .dot2 { width: 7px; height: 7px; border-radius: 50%; background: var(--highlight); }
  [data-theme="bauhaus"] .dot2 { border-radius: 0; }

  .kron__flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; position: relative; }
  /* connecting spine */
  .kspine { position: absolute; left: 19px; top: 24px; bottom: 24px; width: 2px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .kspine__fill { position: absolute; inset: 0; background: var(--accent); transform: scaleY(0); transform-origin: top; }
  .kron.play .kspine__fill { animation: spine 2.4s var(--ease) 0.4s both; }
  @keyframes spine { to { transform: scaleY(1); } }

  .kstep { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: center; padding: 0.5rem 0; position: relative; opacity: 0.4; }
  .kron.play .kstep { animation: stepOn 0.5s var(--ease) both; }
  .kron.play .kstep--1 { animation-delay: 0.3s; }
  .kron.play .kstep--2 { animation-delay: 1.0s; }
  .kron.play .kstep--3 { animation-delay: 1.7s; }
  .kron.play .kstep--4 { animation-delay: 2.4s; }
  @keyframes stepOn { from { opacity: 0.35; } to { opacity: 1; } }

  .kstep__ico { width: 40px; height: 40px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--surface-2); border: 1px solid var(--border-strong); color: var(--ink-3); z-index: 1; transition: none; }
  [data-theme="bauhaus"] .kstep__ico { border-radius: 0; }
  .kstep__ico svg { width: 20px; height: 20px; }
  .kstep__ai { font-family: var(--font-mono); font-weight: 700; font-size: 0.72rem; }
  .kron.play .kstep--1 .kstep__ico { animation: icoOn 0.4s var(--ease) 0.35s both; }
  .kron.play .kstep--2 .kstep__ico { animation: icoOn 0.4s var(--ease) 1.05s both; }
  .kron.play .kstep--3 .kstep__ico { animation: icoOn 0.45s var(--ease-spring) 1.75s both; }
  .kron.play .kstep--4 .kstep__ico { animation: icoOn 0.4s var(--ease) 2.45s both; }
  @keyframes icoOn {
    0% { background: var(--surface-2); border-color: var(--border-strong); color: var(--ink-3); transform: scale(1); }
    50% { transform: scale(1.12); }
    100% { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); transform: scale(1); }
  }

  .kstep__b b { font-family: var(--font-display); display: block; font-size: 0.95rem; margin-bottom: 0.15rem; }
  .kstep__b span { color: var(--ink-3); font-size: 0.82rem; line-height: 1.4; }

  /* step 2 mini note lines fill as AI writes */
  .kstep__lines { display: grid; gap: 0.32rem; margin-top: 0.1rem; }
  .kstep__lines i { height: 5px; border-radius: 3px; background: var(--surface-3); width: 0; }
  [data-theme="bauhaus"] .kstep__lines i { border-radius: 0; }
  .kron.play .kstep__lines i { animation: writeLine 0.4s var(--ease) both; }
  .kron.play .kstep__lines i:nth-child(1) { animation-delay: 1.15s; }
  .kron.play .kstep__lines i:nth-child(2) { animation-delay: 1.32s; }
  .kron.play .kstep__lines i:nth-child(3) { animation-delay: 1.49s; }
  @keyframes writeLine { to { width: var(--w); } }

  /* step 3 tick draws */
  .kstep__tick { stroke-dasharray: 26; stroke-dashoffset: 26; }
  .kron.play .kstep__tick { animation: draw 0.4s var(--ease) 2.0s both; }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* auditable badge lights + pulses once the record is written */
  .kron.play .kron__badge { animation: auditIn 0.4s var(--ease) 2.7s both; }
  @keyframes auditIn { to { color: var(--highlight); } }
  .kron.play .dot2 { animation: aud 2s var(--ease-in-out) 2.9s infinite; }
