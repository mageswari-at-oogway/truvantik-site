---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";

const cases = [
  {
    n: "01", sector: "Healthcare", tag: "Completed engagement", real: true,
    title: "Kron Health: a digital clinic platform",
    problem: "Delivering a clinic platform where AI-assisted workflows had to fit clinical reality: careful handling of patient information, review by a clinician at the right point, and behaviour that is auditable rather than opaque.",
    did: ["Product & platform engineering across clinical and patient-facing workflows", "AI-assisted documentation and intake with clinician review in the loop", "Evaluation and monitoring built in from the start, not retrofitted"],
    outcome: "A shipped, working product, and the clearest illustration of the depth of build work our team takes on when a domain demands care rather than speed.",
  },
  {
    n: "02", sector: "Financial services", tag: "Representative scenario", real: false,
    title: "Cutting manual review on document-heavy onboarding",
    problem: "An operations team spent most of its day extracting the same fields from inconsistent documents, then re-checking them, with a growing backlog and no way to see where errors originated.",
    did: ["Mapped the review workflow and built an evaluation set with the reviewers themselves", "Extraction with confidence thresholds that route uncertain cases to a person", "Integrated into the existing case system so reviewers never left their workflow"],
    outcome: "Reviewers moved from transcription to judgement on exceptions, with an audit trail on every automated decision.",
  },
  {
    n: "03", sector: "Retail & e-commerce", tag: "Representative scenario", real: false,
    title: "Scaling catalogue operations without scaling the team",
    problem: "Content operations could not keep pace with new supplier ranges. Product data quality varied by supplier, and inconsistent listings were suppressing conversion.",
    did: ["Normalisation and enrichment pipeline over supplier feeds", "Generated copy and attributes held to a house style guide, with merchandiser approval before publish", "Quality measures reported per supplier so the worst inputs got fixed at source"],
    outcome: "A catalogue pipeline the merchandising team runs itself, with human approval kept where brand risk actually sits.",
  },
  {
    n: "04", sector: "Manufacturing & industrial", tag: "Representative scenario", real: false,
    title: "Restarting a stalled quality-inspection pilot",
    problem: "A promising inspection model had sat unused for two quarters. Nobody on the line could act on its output, and it had never passed internal security review.",
    did: ["Diagnosed the stall as integration and ownership rather than model quality", "Deployed inside the plant's own environment with monitoring and continuous evaluation", "Surfaced results in the tool operators already used, and named an owner for the decision"],
    outcome: "The capability moved from a parked notebook to a routine part of the shift, with the plant team owning it after handover.",
  },
];
---
<Base
  title="Case studies: AI projects across industries | Truvantik"
  description="Where clients have published figures, we cite them. Where they have not, we describe the shape of the work rather than invent numbers."
>
  <section class="snap work-intro gridbg">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap">
      <p class="kicker reveal">Case studies</p>
      <h1 class="reveal" style="--d:60ms">What the work<br /><span class="grad-text">actually looks like.</span></h1>
      <p class="lead reveal" style="--d:140ms">Where clients have published figures, we cite them. Where they have not, we describe the shape of the work rather than invent numbers.</p>
    </div>
  </section>

  {cases.map((c) => (
    <section class="snap wcase">
      <div class="wrap wcase__in">
        <header class="wcase__head reveal">
          <span class="wcase__n grad-text">{c.n}</span>
          <div class="wcase__labels">
            <span class="wcase__tag">{c.sector}</span>
            <span class:list={["wcase__tag", c.real ? "wcase__tag--real" : "wcase__tag--rep"]}>{c.tag}</span>
          </div>
          <h2>{c.title}</h2>
        </header>
        <div class="wcase__grid reveal" style="--d:120ms">
          <div class="wcase__block">
            <h3 class="wcase__sub">The problem</h3>
            <p class="muted">{c.problem}</p>
          </div>
          <div class="wcase__block">
            <h3 class="wcase__sub">What we did</h3>
            <ul class="wcase__list">{c.did.map((d) => <li>{d}</li>)}</ul>
          </div>
          <div class="wcase__block wcase__block--out">
            <h3 class="wcase__sub">Outcome</h3>
            <p>{c.outcome}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <CtaBand title="Tell us the problem." sub="If your work involves repetitive judgement over messy data inside systems people already use, there is probably a version of these here for you." />
</Base>

<style>
  .work-intro h1 { margin: 1rem 0 1.4rem; }

  .wcase { min-height: auto; scroll-snap-align: none; padding-block: clamp(5rem, 10vw, 9rem); border-top: 1px solid var(--rule); }
  .wcase__in { position: relative; display: grid; grid-template-columns: clamp(4.5rem, 9vw, 8rem) minmax(0, 1fr); column-gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .wcase__in::before { content: ""; position: absolute; left: calc(clamp(4.5rem, 9vw, 8rem) / 2); top: 1rem; bottom: 1rem; width: 1px; background: var(--border); }
  .wcase__head { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: 0.8rem; align-items: start; padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .wcase__n { grid-column: 1; grid-row: span 2; justify-self: center; position: relative; z-index: 1; width: 2.35rem; aspect-ratio: 1; display: grid; place-items: center; background: var(--bg); font-family: var(--font-display); font-weight: 650; font-size: 0.9rem; color: var(--accent); }
  .wcase__labels { grid-column: 2; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .wcase__tag { font-family: var(--font-display); font-size: 0.72rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
  .wcase__tag + .wcase__tag::before { content: "•"; color: var(--accent); margin-right: 0.75rem; }
  .wcase__tag--real { color: var(--accent); }
  .wcase__head h2 { grid-column: 2; font-size: clamp(2.4rem, 2rem + 2.2vw, 4.5rem); line-height: 0.95; letter-spacing: -0.04em; max-width: 15ch; }

  .wcase__grid { grid-column: 2; display: grid; }
  .wcase__block { display: grid; grid-template-columns: minmax(7rem, 0.35fr) minmax(0, 1fr); gap: 1.5rem; padding-block: clamp(1.5rem, 3vw, 2.4rem); border-top: 1px solid var(--border); }
  .wcase__block--out { border-bottom: 1px solid var(--border); }
  .wcase__sub { font-family: var(--font-display); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin: 0; font-weight: 650; }
  .wcase__block p { max-width: 62ch; color: var(--ink-2); font-size: 1rem; line-height: 1.62; }
  .wcase__block--out p { color: var(--ink); font-size: clamp(1.08rem, 1rem + 0.2vw, 1.2rem); font-weight: 500; }
  .wcase__list { list-style: none; padding: 0; display: grid; gap: 0.7rem; max-width: 62ch; }
  .wcase__list li { position: relative; padding-left: 1.25rem; color: var(--ink-2); font-size: 1rem; line-height: 1.5; }
  .wcase__list li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; border-radius: 2px; background: var(--grad); }

  @media (max-width: 700px) {
    .wcase__in { grid-template-columns: 1fr; }
    .wcase__in::before { display: none; }
    .wcase__head, .wcase__grid { grid-column: 1; }
    .wcase__head { grid-template-columns: 1fr; }
    .wcase__n, .wcase__labels, .wcase__head h2 { grid-column: 1; grid-row: auto; justify-self: start; }
    .wcase__n { width: auto; aspect-ratio: auto; background: none; font-size: 0.78rem; }
    .wcase__block { grid-template-columns: 1fr; gap: 0.7rem; }
  }
</style>
