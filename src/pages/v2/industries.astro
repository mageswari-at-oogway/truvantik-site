---
import Layout from '../../v2/Layout.astro';
import PageIntro from '../../v2/components/PageIntro.astro';
import Close from '../../v2/components/Close.astro';
import Arrow from '../../v2/components/Arrow.astro';
import { industries } from '../../v2/content';
import { contact } from '../../v2/routes';
---
<Layout page="industries" title="Industries: shared patterns, specific constraints" description="AI workflows for healthcare, retail, manufacturing and consumer technology, shaped around each sector’s data, people and risk.">
  <PageIntro title="Patterns transfer. Context matters." description="Documents, exceptions and scattered knowledge appear in every sector. The language, systems and consequences are what change." />
  <nav class="container jump-nav" aria-label="Choose an industry">{industries.map(ind => <a href={`#${ind.id}`}>{ind.title}<Arrow /></a>)}</nav>
  <div class="container industry-list">{industries.map(ind => <section class="industry" id={ind.id}><div><h2>{ind.title}</h2><p class="lead">{ind.context}</p></div><div><h3>Workflows to explore</h3><ul class="plain-list">{ind.workflows.map(w => <li>{w}</li>)}</ul></div><div><h3>Design around</h3><p class="muted">{ind.constraint}</p><a class="text-link" href={contact(ind.title)}>Discuss your context <Arrow /></a></div></section>)}</div>
  <section class="container section split"><h2>Your sector isn’t the starting point. Your workflow is.</h2><div class="prose"><p>If your team makes repetitive decisions over messy data, there may be a useful place to start. We’ll examine the workflow before recommending the technology.</p><p class="small">These are areas to explore, not promises of specific performance or business results.</p></div></section>
  <Close title="Bring us the context we can’t see from here." />
</Layout>
