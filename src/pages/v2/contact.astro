---
import Layout from '../../v2/Layout.astro';
import Arrow from '../../v2/components/Arrow.astro';
import { startingPoints } from '../../v2/content';
---
<Layout page="contact" title="Start a conversation" description="Tell Truvantik about your project. Prepare an email to hello@truvantik.com; nothing is submitted through this preview.">
  <section class="container section contact-grid">
    <div class="contact-intro"><h1>Start with the problem.</h1><p class="lead">What is your team trying to do, and what is getting in the way?</p><p class="muted space-top">A few lines are enough. You don’t need a complete brief or a decision about the technology.</p><a class="text-link space-top" href="mailto:hello@truvantik.com">hello@truvantik.com <Arrow /></a><div class="contact-expect"><h2>A useful first conversation covers</h2><ul class="plain-list"><li>Your current workflow</li><li>The people and systems involved</li><li>What a better outcome looks like</li></ul></div></div>
    <div class="contact-panel">
      <p id="form-help" class="form-notice">This preview prepares an email. Nothing is submitted here. You’ll review and send it in your email app.</p>
      <noscript><p class="form-notice">The email composer needs JavaScript. You can <a class="text-link" href="mailto:hello@truvantik.com">email us directly</a> instead.</p></noscript>
      <form id="enquiry" aria-describedby="form-help" hidden novalidate>
        <div class="form-row"><div class="field"><label for="name">Your name <span>(required)</span></label><input id="name" name="name" autocomplete="name" required maxlength="100" aria-describedby="name-error" /><p class="field-error" id="name-error"></p></div><div class="field"><label for="company">Company <span>(optional)</span></label><input id="company" name="company" autocomplete="organization" maxlength="150" /></div></div>
        <div class="field"><label for="email">Email <span>(required)</span></label><input type="email" id="email" name="email" autocomplete="email" required maxlength="254" aria-describedby="email-error" /><p class="field-error" id="email-error"></p></div>
        <div class="field"><label for="start">Where are you starting? <span>(optional)</span></label><select id="start" name="start"><option value="">I’m not sure yet</option>{startingPoints.map(p => <option value={p.id}>{p.title}</option>)}<option value="advisory">We need ongoing guidance.</option><option value="other">Something else</option></select></div>
        <div class="field"><label for="message">What would you like to improve? <span>(required)</span></label><textarea id="message" name="message" required rows="5" maxlength="2500" aria-describedby="message-help message-error"></textarea><p id="message-help" class="small">Please leave out confidential information and patient data. Maximum 2,500 characters.</p><p class="field-error" id="message-error"></p></div>
        <button class="button" type="submit">Prepare email <Arrow /></button><p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
      <section class="email-preview" id="email-preview" aria-labelledby="preview-heading" hidden><h2 id="preview-heading" tabindex="-1">Your draft is ready.</h2><p class="muted">Nothing has been sent. Open your email app, or copy the draft and send it to hello@truvantik.com.</p><label for="draft">Email draft</label><textarea id="draft" rows="9" readonly></textarea><div class="actions"><a class="button" id="open-email">Open email app <Arrow /></a><button class="button button--secondary" type="button" id="copy-email">Copy draft</button></div><p id="copy-status" role="status" aria-live="polite" class="small"></p><p class="small">You can edit the form above and prepare it again.</p></section>
    </div>
  </section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry')!;
  const name = form.elements.namedItem('name') as HTMLInputElement;
  const email = form.elements.namedItem('email') as HTMLInputElement;
  const company = form.elements.namedItem('company') as HTMLInputElement;
  const start = form.elements.namedItem('start') as HTMLSelectElement;
  const message = form.elements.namedItem('message') as HTMLTextAreaElement;
  const status = document.querySelector<HTMLElement>('#form-status')!;
  const preview = document.querySelector<HTMLElement>('#email-preview')!;
  const draft = document.querySelector<HTMLTextAreaElement>('#draft')!;
  const openEmail = document.querySelector<HTMLAnchorElement>('#open-email')!;
  const copyStatus = document.querySelector<HTMLElement>('#copy-status')!;
  const selection = new URLSearchParams(location.search).get('start');
  if (selection && [...start.options].some(option => option.value === selection)) start.value = selection;
  else if (selection) start.value = 'other';
  form.hidden = false;
  const errorFor = (field: HTMLInputElement | HTMLTextAreaElement) => {
    if (!field.value.trim()) return `Please enter ${field === name ? 'your name' : field === email ? 'your email address' : 'a short description of the problem'}.`;
    if (!field.validity.valid) return field === email ? 'Please enter a valid email address, such as name@company.com.' : 'Please shorten your answer to fit the field limit.';
    return '';
  };
  const setError = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const error = errorFor(field);
    document.getElementById(`${field.id}-error`)!.textContent = error;
    field.setAttribute('aria-invalid', String(Boolean(error)));
    return Boolean(error);
  };
  [name, email, message].forEach(field => field.addEventListener('input', () => {
    if (field.getAttribute('aria-invalid') === 'true') setError(field);
  }));
  form.addEventListener('input', () => { if (!preview.hidden) { preview.hidden = true; status.textContent = 'Your details changed. Prepare the email again to update the draft.'; } });
  form.addEventListener('submit', event => {
    event.preventDefault();
    const invalid = [name, email, message].filter(setError);
    if (invalid.length) { preview.hidden = true; status.textContent = 'Please check the highlighted fields.'; invalid[0].focus(); return; }
    const subject = 'Project enquiry — Truvantik';
    const body = `Hello Truvantik,\n\n${message.value.trim()}\n\nName: ${name.value.trim()}\nEmail: ${email.value.trim()}${company.value.trim() ? `\nCompany: ${company.value.trim()}` : ''}\nStarting point: ${start.selectedOptions[0].textContent}\n`;
    draft.value = `To: hello@truvantik.com\nSubject: ${subject}\n\n${body}`;
    openEmail.href = `mailto:hello@truvantik.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    preview.hidden = false; status.textContent = 'Draft prepared. Nothing has been sent.'; copyStatus.textContent = '';
    document.getElementById('preview-heading')!.focus();
  });
  document.getElementById('copy-email')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(draft.value); copyStatus.textContent = 'Draft copied. Paste it into your email app to send.'; }
    catch { draft.focus(); draft.select(); copyStatus.textContent = 'Automatic copying is unavailable. The draft is selected; copy it with your keyboard or device menu.'; }
  });
</script>
