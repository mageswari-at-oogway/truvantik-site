---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";

const approach = [
  { title: "Understand", text: "Learn how the work happens before choosing a direction." },
  { title: "Build", text: "Create the right solution with the people who will use it." },
  { title: "Embed", text: "Fit it into everyday systems so your team can own it." },
];

const structure = [
  { name: "Truvantik", role: "Client work: strategy, build and integration." },
  { name: "Prabhaavi Solutions", role: "The legal entity behind Truvantik." },
  { name: "3BP Labs", role: "Our engineering partner." },
  { name: "Kron Health", role: "A digital clinic product built by our team with 3BP Labs." },
];

---
<Base
  title="About: founder-led, engineering-led AI consulting | Truvantik"
  description="Truvantik brings strategy, engineering and integration together so AI becomes useful in everyday work."
>
  <section class="about-hero snap" aria-labelledby="about-title">
    <div class="aurora" aria-hidden="true"></div>
    <div class="wrap about-hero__in">
      <p class="kicker reveal">About Truvantik</p>
      <h1 id="about-title" class="reveal" style="--d:60ms">Built for AI<br /><span class="grad-text">that gets used.</span></h1>
      <p class="about-hero__summary reveal" style="--d:120ms">We bring strategy, engineering and integration together so AI becomes part of everyday work.</p>
    </div>
  </section>

  <section class="about-story snap--auto" aria-labelledby="story-title">
    <div class="wrap about-story__in">
      <h2 id="story-title" class="reveal">Why we started Truvantik.</h2>
      <div class="about-story__copy reveal" style="--d:80ms">
        <p>We started Truvantik after watching the same pattern repeat. An organization commits to AI, funds a pilot, and a year later has a working notebook nobody uses. The modelling is rarely the hard part. Integration, ownership, evaluation and adoption are.</p>
        <p>That is why we work across the whole path. We start by learning where value is, build the right solution, integrate it into the systems people already use, and stay long enough for your team to own it. When buying a tool or stopping a project is the right answer, we say so.</p>
        <p>We work across sectors on purpose. A pattern that works for document-heavy review in underwriting can be adapted for clinical intake or customs clearance. That transfer is your true advantage.</p>
      </div>
    </div>
  </section>

  <section class="about-method snap--auto" aria-labelledby="method-title">
    <div class="wrap about-method__in">
      <header class="about-method__intro reveal">
        <h2 id="method-title">From the first conversation to everyday work.</h2>
        <p>Good AI needs more than a capable model. It needs a clear problem, the right workflow and people who can carry it forward.</p>
      </header>
      <ol class="about-method__steps" aria-label="How we work">
        {approach.map((item, index) => (
          <li class="reveal" style={`--d:${(index + 1) * 80}ms`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><h3>{item.title}</h3><p>{item.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="about-structure snap--auto" aria-labelledby="structure-title">
    <div class="wrap about-structure__in">
      <header class="about-structure__intro reveal">
        <h2 id="structure-title">One team, clear roles.</h2>
        <p>Specialist capabilities working together, without making the client experience complicated.</p>
      </header>
      <ul class="about-structure__list reveal" style="--d:100ms">
        {structure.map((item, index) => (
          <li class:list={{ "is-primary": index === 0 }}>
            <span class="about-structure__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.name}</h3>
            <p>{item.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about-hero { overflow: clip; }
  .about-hero__in { display: grid; align-content: center; min-height: 100svh; padding-block: clamp(6rem, 12vh, 9rem); }
  .about-hero .kicker { margin-bottom: clamp(1.7rem, 3vw, 2.5rem); }
  .about-hero h1 { max-width: 14ch; margin-bottom: 1.35rem; font-size: var(--page-title); line-height: .94; letter-spacing: -.04em; }
  .about-hero__summary { max-width: 55ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; }

  .about-story { min-height: auto; scroll-snap-align: none; border-top: 1px solid var(--rule); padding-block: clamp(5rem, 10vw, 9rem); }
  .about-story__in { display: grid; grid-template-columns: minmax(16rem, .75fr) minmax(0, 1.25fr); gap: clamp(3rem, 10vw, 11rem); align-items: start; }
  .about-story h2 { position: sticky; top: 8rem; max-width: 8ch; font-size: clamp(2rem, 3.5vw, 3.8rem); line-height: .95; letter-spacing: -.04em; }
  .about-story__copy { display: grid; gap: 1.45rem; max-width: 48ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.58; }
  .about-story__copy p:first-child { color: var(--ink); font-size: clamp(1.2rem, 1.08rem + .42vw, 1.5rem); line-height: 1.4; }

  .about-method, .about-structure { min-height: auto; scroll-snap-align: none; border-top: 1px solid var(--rule); padding-block: clamp(5rem, 10vw, 9rem); }
  .about-method__in, .about-structure__in { display: grid; grid-template-columns: minmax(16rem, .75fr) minmax(0, 1.25fr); gap: clamp(3rem, 10vw, 11rem); align-items: start; }
  .about-method__intro, .about-structure__intro { position: sticky; top: 8rem; }
  .about-method__intro h2, .about-structure__intro h2 { max-width: 9ch; font-size: clamp(2rem, 3.5vw, 3.8rem); line-height: .95; letter-spacing: -.04em; margin-bottom: 1.35rem; }
  .about-method__intro p, .about-structure__intro p { max-width: 30ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.5; }
  .about-method__steps { list-style: none; padding: 0; border-top: 1px solid var(--rule); }
  .about-method__steps li { display: grid; grid-template-columns: 4.25rem minmax(0, 1fr); gap: 1rem; padding: clamp(1.7rem, 3.5vw, 3rem) 0; border-bottom: 1px solid var(--rule); }
  .about-method__steps li > span, .about-structure__index { color: var(--accent); font-family: var(--font-display); font-size: .74rem; font-weight: 650; letter-spacing: .08em; }
  .about-method__steps h3 { font-size: clamp(1.45rem, 2vw, 2.15rem); line-height: 1; margin-bottom: .65rem; }
  .about-method__steps p { max-width: 32ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.45; }

  .about-structure { padding-top: clamp(4rem, 8vw, 7.5rem); }
  .about-structure__list { list-style: none; padding: 0; border-top: 1px solid var(--rule); }
  .about-structure__list li { display: grid; grid-template-columns: 4.25rem minmax(12rem, .85fr) minmax(13rem, 1.15fr); gap: 1rem; align-items: baseline; padding: 1.3rem 0; border-bottom: 1px solid var(--rule); }
  .about-structure__list li.is-primary { padding-top: 1.7rem; }
  .about-structure__list h3 { font-size: clamp(1.1rem, 1.2vw, 1.35rem); line-height: 1.15; }
  .about-structure__list p { color: var(--ink-2); font-size: .97rem; line-height: 1.45; }
  .about-structure__list .is-primary h3 { color: var(--accent); }
  :global([data-theme="ember"]) .about-structure__list .is-primary h3 { color: var(--orange); }

  @media (max-width: 860px) {
    .about-story__in, .about-method__in, .about-structure__in { grid-template-columns: 1fr; }
    .about-hero h1 { max-width: 12ch; }
    .about-story h2, .about-method__intro, .about-structure__intro { position: static; }
  }
  @media (max-width: 620px) {
    .about-method__steps li { grid-template-columns: 3rem minmax(0, 1fr); }
    .about-structure__list li { grid-template-columns: 3rem 1fr; gap: .65rem; }
    .about-structure__list p { grid-column: 2; }
  }
</style>
