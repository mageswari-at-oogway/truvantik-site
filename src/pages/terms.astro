---
import Base from "../layouts/Base.astro";
---
<Base title="Terms | Truvantik" description="Terms of use for the Truvantik website.">
  <section class="snap snap--auto legal gridbg">
    <div class="wrap legal__in">
      <p class="kicker">Terms</p>
      <h1>Terms of use</h1>
      <p class="legal__flag">Placeholder: final legal copy to be supplied by Truvantik / Prabhaavi Solutions before launch.</p>
      <div class="legal__body">
        <h2>About this site</h2>
        <p>This website is operated by Truvantik, the AI consulting brand of Prabhaavi Solutions. Content is provided for general information about our services.</p>
        <h2>No warranty</h2>
        <p>Outcome ranges shown are typical of work of this type and are not a guarantee of results for any specific engagement. Case studies marked as representative scenarios are composites, not specific client engagements.</p>
        <h2>Contact</h2>
        <p>Questions about these terms: <a href="mailto:hello@truvantik.com">hello@truvantik.com</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal__in { max-width: 68ch; padding-top: 5rem; }
  .legal__in h1 { font-size: var(--page-title); margin: 1rem 0 1rem; }
  .legal__flag { font-family: var(--font-mono); font-size: 0.82rem; color: var(--highlight); border-left: 2px solid var(--highlight); padding-left: 0.9rem; margin-bottom: 2rem; }
  .legal__body { display: grid; gap: 0.7rem; }
  .legal__body h2 { font-size: var(--step-1); margin-top: 1.4rem; }
  .legal__body p { color: var(--ink-2); }
  .legal__body a { color: var(--accent); text-decoration: underline; }
</style>
