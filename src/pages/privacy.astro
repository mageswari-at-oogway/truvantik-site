---
import Base from "../layouts/Base.astro";
---
<Base title="Privacy policy | Truvantik" description="How Truvantik handles the information you send through this site.">
  <section class="snap snap--auto legal gridbg">
    <div class="wrap legal__in">
      <p class="kicker">Privacy</p>
      <h1>Privacy policy</h1>
      <p class="legal__flag">Placeholder: final legal copy to be supplied by Truvantik / Prabhaavi Solutions before launch.</p>
      <div class="legal__body">
        <h2>What we collect</h2>
        <p>When you contact us we collect the name, work email, company and message you choose to send. We use this only to respond to your enquiry and to scope a possible engagement.</p>
        <h2>How we use it</h2>
        <p>We do not sell your information. We do not add you to marketing lists without your consent. We retain enquiry details only as long as needed to follow up.</p>
        <h2>Contact</h2>
        <p>For any privacy question, email <a href="mailto:hello@truvantik.com">hello@truvantik.com</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal__in { max-width: 68ch; padding-top: 5rem; }
  .legal__in h1 { font-size: var(--page-title); margin: 1rem 0 1rem; }
  .legal__flag { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); border-left: 2px solid var(--accent); padding-left: 0.9rem; margin-bottom: 2rem; }
  .legal__body { display: grid; gap: 0.7rem; }
  .legal__body h2 { font-size: var(--step-1); margin-top: 1.4rem; }
  .legal__body p { color: var(--ink-2); }
  .legal__body a { color: var(--accent); text-decoration: underline; }
</style>
